# Copier en .env à la racine (jamais commité). Générer des mots de passe longs et aléatoires.
POSTGRES_DB=cadrage
POSTGRES_USER=cadrage
POSTGRES_PASSWORD=
PUBLIC_PORT=8080
LOG_LEVEL=INFO
# fake = faux modèle (démonstration) ; ollama = vrai modèle local (profil « llm » ou Ollama sur le réseau interne)
LLM_PROVIDER=fake
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_GENERATION_MODEL=
OLLAMA_EMBEDDING_MODEL=
