# Copier en .env (jamais commité) puis renseigner. Aucune valeur secrète dans ce fichier.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
API_PORT=8000
LOG_LEVEL=INFO

# --- Modèle réel (lot T2, mesuré sur GTX 1650 4 Go) ---
# fake = faux modèle (démo/tests) ; ollama = vrai modèle local
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_GENERATION_MODEL=qwen3:4b
OLLAMA_EMBEDDING_MODEL=bge-m3
# Registre de modèles (page Modèles / python -m app.models_registry) : fichier local, ignoré par Git
MODELS_REGISTRY_PATH=./data/models.json
# Qwen3 : réflexion désactivée (sinon latence x5 et jetons gaspillés)
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=30m
LLM_TIMEOUT_SECONDS=300
# bge-m3 : 1024 dimensions, AUCUN préfixe (e5 : "query: " / "passage: "). Changer de modèle = ré-indexer.
EMBEDDING_DIM=1024
EMBEDDING_PASSAGE_PREFIX=
# Réglage retenu (T2) : toutes les couches sur le GPU = latence -25 %, refus erronés 60 % -> 10 %
OLLAMA_NUM_GPU=99
