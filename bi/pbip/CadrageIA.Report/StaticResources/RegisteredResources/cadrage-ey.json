        "labels": [{"fontSize": 28, "fontFamily": "Segoe UI Semibold", "color": {"solid": {"color": "#2E2E38"}}}],
        "categoryLabels": [{"fontSize": 11, "color": {"solid": {"color": "#747480"}}}],
        "border": [{"show": true, "color": {"solid": {"color": "#FFE600"}}, "radius": 2}]
