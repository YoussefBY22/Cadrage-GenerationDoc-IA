  },
  "visualStyles": {
    "*": {
      "*": {
        "*": [{"fontFamily": "Segoe UI", "color": {"solid": {"color": "#747480"}}}],
        "background": [{"show": true, "color": {"solid": {"color": "#FFFFFF"}}, "transparency": 0}],
        "border": [{"show": true, "color": {"solid": {"color": "#C4C4CD"}}, "radius": 2}],
        "title": [{"show": true, "fontColor": {"solid": {"color": "#2E2E38"}}, "fontFamily": "Segoe UI Semibold", "fontSize": 12, "alignment": "left"}],
        "legend": [{"fontFamily": "Segoe UI", "fontSize": 10, "labelColor": {"solid": {"color": "#747480"}}}],
