  "background": "#FFFFFF",
  "foreground": "#2E2E38",
  "tableAccent": "#FFE600",
  "good": "#2E2E38",
  "neutral": "#C4C4CD",
  "bad": "#B4232F",
  "maximum": "#FFE600",
