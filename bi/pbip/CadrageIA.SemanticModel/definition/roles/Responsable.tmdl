role Responsable
	modelPermission: read

	tablePermission Projets = 'Projets'[Clé de mission] IN SELECTCOLUMNS(FILTER(Livrables, Livrables[Clé de responsable] IN CALCULATETABLE(VALUES('Accès'[Clé de personne autorisée]), 'Accès'[Utilisateur] = USERPRINCIPALNAME())), "k", Livrables[Clé de mission])

	tablePermission 'Accès' = 'Accès'[Utilisateur] = USERPRINCIPALNAME()
