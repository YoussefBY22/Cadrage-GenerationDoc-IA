role Consultant
	modelPermission: read

	tablePermission Projets = 'Projets'[Clé de mission] IN UNION(SELECTCOLUMNS(FILTER(Livrables, Livrables[Clé de consultant] IN CALCULATETABLE(VALUES('Accès'[Clé de personne autorisée]), 'Accès'[Utilisateur] = USERPRINCIPALNAME())), "k", Livrables[Clé de mission]), SELECTCOLUMNS(FILTER('Générations', 'Générations'[Clé de consultant] IN CALCULATETABLE(VALUES('Accès'[Clé de personne autorisée]), 'Accès'[Utilisateur] = USERPRINCIPALNAME())), "k", 'Générations'[Clé de mission]))

	tablePermission Personnes = 'Personnes'[Clé de personne] IN CALCULATETABLE(VALUES('Accès'[Clé de personne autorisée]), 'Accès'[Utilisateur] = USERPRINCIPALNAME())

	tablePermission 'Accès' = 'Accès'[Utilisateur] = USERPRINCIPALNAME()
