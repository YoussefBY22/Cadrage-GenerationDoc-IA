table 'Critères'
	isHidden

	column 'Critère'
		dataType: string
		sourceColumn: libelle
		sortByColumn: Ordre
		summarizeBy: none

	column Ordre
		dataType: int64
		isHidden
		sourceColumn: ordre
		summarizeBy: none

	partition 'Critères' = m
		mode: import
		source =
				let
				    Resultat = #table(type table [#"libelle" = text, #"ordre" = Int64.Type], {{"Phrases vérifiées", 1}, {"Citations valides", 2}, {"Chiffres retrouvés", 3}, {"Acceptées sans retouche", 4}})
				in
				    Resultat
