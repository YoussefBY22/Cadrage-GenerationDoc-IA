table Relectures
	isHidden

	column 'Identifiant du livrable'
		dataType: string
		isHidden
		sourceColumn: deliverable_id
		summarizeBy: none

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Clé de type'
		dataType: int64
		isHidden
		sourceColumn: type_key
		summarizeBy: none

	column 'Clé de date'
		dataType: int64
		isHidden
		sourceColumn: approved_date_key
		summarizeBy: none

	column Renvois
		dataType: int64
		isHidden
		sourceColumn: rejections
		summarizeBy: none

	column Soumissions
		dataType: int64
		isHidden
		sourceColumn: submissions
		summarizeBy: none

	column 'Délai en heures'
		dataType: double
		isHidden
		sourceColumn: delay_hours
		summarizeBy: none

	partition Relectures = m
		mode: import
		source =
				let
				    Brut = Vue("v_review_funnel"),
				    Choix = Table.SelectColumns(Brut, {"deliverable_id", "mission_key", "type_key", "approved_date_key", "rejections", "submissions", "delay_hours"}, MissingField.UseNull),
				    Typage = Table.TransformColumnTypes(Choix, {{"deliverable_id", type text}, {"mission_key", Int64.Type}, {"type_key", Int64.Type}, {"approved_date_key", Int64.Type}, {"rejections", Int64.Type}, {"submissions", Int64.Type}, {"delay_hours", type number}}, CultureCsv)
				in
				    Typage
