table Configurations

	column Configuration
		dataType: string
		sourceColumn: config
		summarizeBy: none

	column 'Configuration et modèle'
		dataType: string
		sourceColumn: libelle
		sortByColumn: Configuration
		summarizeBy: none

	partition Configurations = m
		mode: import
		source =
				let
				    Paires = Table.AddColumn(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_generation"), {"config_label", "model_name"}), {{"config_label", type text}, {"model_name", type text}}, CultureCsv), "config", each if [config_label] = null or [config_label] = "" then "Non étiquetée" else [config_label], type text),
				    Groupes = Table.Group(Paires, {"config"}, {{"libelle", each [config]{0} & " · " & Text.Combine(List.Distinct(List.Transform([model_name], Text.From)), ", "), type text}})
				in
				    Groupes
