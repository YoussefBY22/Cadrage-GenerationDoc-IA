table _Mesures

	column Colonne
		dataType: string
		isHidden
		sourceColumn: Colonne

	measure TPV = DIVIDE(SUM(v_generation[sentences_verified]), SUM(v_generation[sentences_total]))
		formatString: 0.0%

	measure 'Citations valides' = DIVIDE(SUM(v_generation[citations_valid]), SUM(v_generation[citations_total]))
		formatString: 0.0%

	measure 'Fidélité chiffres' = IF(SUM(v_generation[numbers_cited]) = 0, 1, DIVIDE(SUM(v_generation[numbers_found]), SUM(v_generation[numbers_cited])))
		formatString: 0.0%

	measure 'Taux refus' = DIVIDE(CALCULATE(COUNTROWS(v_generation), v_generation[status] = "refused"), COUNTROWS(v_generation))
		formatString: 0.0%

	measure 'Acceptation sans modif' = DIVIDE(CALCULATE(COUNTROWS(v_outcome), v_outcome[unchanged] = 1), COUNTROWS(v_outcome))
		formatString: 0.0%

	measure 'Temps gagné (h)' = SUM(v_outcome[minutes_saved_est]) / 60
		formatString: 0.0

	measure 'Latence p95 (s)' = PERCENTILEX.INC(v_llm_calls, v_llm_calls[latency_ms], 0.95) / 1000
		formatString: 0.0

	measure 'Δ TPV vs B' = [TPV] - CALCULATE([TPV], REMOVEFILTERS(Modèles[config_label]), Modèles[config_label] = "B")
		formatString: +0.0%;-0.0%;0.0%

	measure 'Livrables approuvés' = DISTINCTCOUNT(v_outcome[deliverable_id])
		formatString: #,0

	measure 'Générations' = COUNTROWS(v_generation)
		formatString: #,0

	measure 'Contrôles de citation' = COUNTROWS(v_citations)
		formatString: #,0

	measure 'Réécriture moyenne' = AVERAGE(v_outcome[edit_ratio])
		formatString: 0.0%

	measure 'Délai médian (h)' = MEDIAN(v_review_funnel[delay_hours])
		formatString: 0.0

	measure 'Taux refus relecture' = DIVIDE(SUM(v_review_funnel[rejections]), SUM(v_review_funnel[submissions]))
		formatString: 0.0%

	measure 'Alertes d'injection' = SUM(v_security[injection_alert_count])
		formatString: #,0

	measure Documents = COUNTROWS(v_security)
		formatString: #,0

	measure 'Livrables à l'étape' = SWITCH(SELECTEDVALUE(Etapes[Ordre]), 1, DISTINCTCOUNT(v_review_funnel[deliverable_id]), 2, CALCULATE(DISTINCTCOUNT(v_review_funnel[deliverable_id]), v_review_funnel[submissions] > 0), 3, CALCULATE(DISTINCTCOUNT(v_review_funnel[deliverable_id]), v_review_funnel[approved_date_key] <> BLANK()))
		formatString: #,0

	partition _Mesures = m
		mode: import
		source = #table(type table [Colonne = text], {})
