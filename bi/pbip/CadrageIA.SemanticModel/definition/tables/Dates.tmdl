table Dates

	column Date
		dataType: dateTime
		formatString: dd/mm/yyyy
		sourceColumn: Date
		summarizeBy: none

	column date_key
		dataType: int64
		isHidden
		sourceColumn: date_key
		summarizeBy: none

	column Semaine
		dataType: dateTime
		formatString: dd/mm
		sourceColumn: Semaine
		summarizeBy: none

	partition Dates = m
		mode: import
		source =
				let
				    Liste = List.Dates(#date(2026, 1, 1), 730, #duration(1, 0, 0, 0)),
				    T = Table.FromList(Liste, Splitter.SplitByNothing(), {"Date"}, null, ExtraValues.Error),
				    Clé = Table.AddColumn(T, "date_key", each Date.Year([Date]) * 10000 + Date.Month([Date]) * 100 + Date.Day([Date]), Int64.Type),
				    Sem = Table.AddColumn(Clé, "Semaine", each Date.StartOfWeek([Date], Day.Monday), type date),
				    Types = Table.TransformColumnTypes(Sem, {{"Date", type date}})
				in
				    Types
