table 'Série de prévision'

	column 'Clé de prévision'
		dataType: int64
		isHidden
		sourceColumn: forecast_key
		summarizeBy: none

	column 'Fin de quinzaine'
		dataType: dateTime
		formatString: dd/MM
		sourceColumn: period_end
		summarizeBy: none

	column 'Réel'
		dataType: int64
		isHidden
		sourceColumn: actual
		summarizeBy: none

	column 'Point prévu'
		dataType: double
		isHidden
		sourceColumn: point
		summarizeBy: none

	column 'Borne basse prévue'
		dataType: double
		isHidden
		sourceColumn: low
		summarizeBy: none

	column 'Borne haute prévue'
		dataType: double
		isHidden
		sourceColumn: high
		summarizeBy: none

	partition 'Série de prévision' = m
		mode: import
		source =
				let
				    Brut = Vue("v_forecast_point"),
				    Choix = Table.SelectColumns(Brut, {"forecast_key", "period_end", "actual", "point", "low", "high"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"forecast_key", Int64.Type}, {"period_end", type date}, {"actual", Int64.Type}, {"point", type number}, {"low", type number}, {"high", type number}}, CultureCsv)
				in
				    Typage
