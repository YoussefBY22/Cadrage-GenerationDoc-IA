table Projets

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column Projet
		dataType: string
		sourceColumn: mission_name
		summarizeBy: none

	column Client
		dataType: string
		sourceColumn: client_name
		summarizeBy: none

	column Secteur
		dataType: string
		sourceColumn: sector
		summarizeBy: none

	column 'Demande du client'
		dataType: string
		sourceColumn: request_summary
		summarizeBy: none

	column 'Clé de début'
		dataType: int64
		isHidden
		sourceColumn: start_date_key
		summarizeBy: none

	column 'Clé de fin'
		dataType: int64
		isHidden
		sourceColumn: end_date_key
		summarizeBy: none

	column Logo
		dataType: string
		dataCategory: ImageUrl
		sourceColumn: logo
		summarizeBy: none

	column Documents
		dataType: int64
		isHidden
		sourceColumn: documents
		summarizeBy: none

	column 'Rapports d''audit'
		dataType: int64
		isHidden
		sourceColumn: audit_reports
		summarizeBy: none

	column 'Est une démonstration'
		dataType: int64
		isHidden
		sourceColumn: is_demo
		summarizeBy: none

	column 'Données'
		dataType: string
		sourceColumn: donnees
		summarizeBy: none

	column 'Début'
		dataType: dateTime
		formatString: dd/MM/yyyy
		sourceColumn: debut
		summarizeBy: none

	column Fin
		dataType: dateTime
		formatString: dd/MM/yyyy
		sourceColumn: fin
		summarizeBy: none

	partition Projets = m
		mode: import
		source =
				let
				    Brut = Vue("v_project"),
				    Choix = Table.SelectColumns(Brut, {"mission_key", "mission_name", "client_name", "sector", "request_summary", "start_date_key", "end_date_key", "logo", "documents", "audit_reports", "is_demo"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"mission_key", Int64.Type}, {"mission_name", type text}, {"client_name", type text}, {"sector", type text}, {"request_summary", type text}, {"start_date_key", Int64.Type}, {"end_date_key", Int64.Type}, {"logo", type text}, {"documents", Int64.Type}, {"audit_reports", Int64.Type}, {"is_demo", Int64.Type}}, CultureCsv),
				    VersDate = (k as number) as date => #date(Number.IntegerDivide(k, 10000), Number.Mod(Number.IntegerDivide(k, 100), 100), Number.Mod(k, 100)),
				    AvecDonnees = Table.AddColumn(Typage, "donnees", each if [is_demo] = 1 then "Démonstration" else "Réelles", type text),
				    AvecDebut = Table.AddColumn(AvecDonnees, "debut", each if [start_date_key] = null then null else VersDate([start_date_key]), type date),
				    AvecFin = Table.AddColumn(AvecDebut, "fin", each if [end_date_key] = null then null else VersDate([end_date_key]), type date)
				in
				    AvecFin
