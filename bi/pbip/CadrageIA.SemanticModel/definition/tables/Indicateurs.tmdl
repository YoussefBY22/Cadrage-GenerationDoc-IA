table Indicateurs

	/// Formule : phrases validées par le vérificateur ÷ phrases des sections générées (TPV, taux de phrases vérifiées).
	/// Pourquoi : c'est la promesse du produit : chaque phrase s'appuie sur une preuve du dossier.
	/// Cible : au moins 50 %. Ce plancher est déduit de H7 : une phrase non vérifiée n'est pas réutilisable telle quelle.
	/// Limite : mesure l'ancrage dans les sources, pas la vérité du contenu.
	measure 'Phrases vérifiées' = DIVIDE([Nombre de phrases vérifiées], [Phrases générées])
		formatString: 0 %
		displayFolder: 1. Qualité et preuves

	/// Formule : citations produites − citations dont la source existe dans le dossier.
	/// Pourquoi : une source inexistante ou prise dans un autre dossier ruine la confiance et peut fuiter entre clients.
	/// Cible : 0 (H7).
	/// Limite : compte ce que le modèle a produit et que le vérificateur a signalé, pas ce qui reste après relecture.
	measure 'Citations inventées' =
			VAR vTotal = SUM('Générations'[Citations produites])
			RETURN IF(NOT ISBLANK(vTotal), vTotal - SUM('Générations'[Citations valides en nombre]))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Formule : chiffres cités retrouvés dans le passage source ÷ chiffres cités.
	/// Pourquoi : un montant, un délai ou un taux faux est l'erreur la plus coûteuse dans un livrable de conseil.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : vide si aucun chiffre n'est cité (kpi.py renvoie 1 dans ce cas).
	measure 'Chiffres retrouvés dans la source' = DIVIDE(SUM('Générations'[Chiffres retrouvés]), SUM('Générations'[Chiffres cités]))
		formatString: 0 %
		displayFolder: 1. Qualité et preuves

	/// Formule : générations de sections refusées ÷ générations de sections (constats exclus).
	/// Pourquoi : un refus vaut mieux qu'une invention ; un taux élevé révèle des dossiers trop pauvres ou une recherche mal réglée.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : kpi.py rapporte les refus à toutes les générations, constats compris.
	measure 'Sections refusées faute de preuve' = DIVIDE([Nombre de sections refusées], [Générations de sections])
		formatString: 0 %
		displayFolder: 1. Qualité et preuves

	/// Formule : minutes gagnées sur les sections rédigées ÷ minutes d'une rédaction manuelle de toutes les sections approuvées.
	/// Pourquoi : c'est le retour sur investissement attendu par le cabinet.
	/// Cible : au moins 30 % (H7).
	/// Limite : estimation : 30 min par section manuelle (à valider), gain proportionnel au texte conservé, relecture non déduite. Une section refusée ne fait rien gagner.
	measure 'Temps gagné' =
			DIVIDE(
			    CALCULATE(SUM('Sections approuvées'[Minutes gagnées]), KEEPFILTERS('Sections approuvées'[Refusée] = 0)),
			    SUM('Sections approuvées'[Minutes de référence]))
		formatString: 0 %
		displayFolder: 2. Productivité et relecture

	/// Formule : heures gagnées ÷ livrables approuvés.
	/// Pourquoi : traduit le pourcentage en temps de consultant rendu à l'analyse.
	/// Cible : aucun seuil en heures dans H7, qui raisonne en pourcentage (voir Temps gagné).
	/// Limite : même estimation que Temps gagné.
	measure 'Temps gagné par livrable' = DIVIDE([Heures gagnées], [Livrables approuvés])
		formatString: 0 "h"
		displayFolder: 2. Productivité et relecture

	/// Formule : sections approuvées mot pour mot ÷ sections rédigées puis approuvées (refus exclus).
	/// Pourquoi : mesure l'adoption réelle : le consultant garde le texte au lieu de le refaire.
	/// Cible : au moins 50 % (H7, « réutilisables telles quelles »).
	/// Limite : H7 raisonne par phrase et l'entrepôt par section : une seule retouche disqualifie la section, la mesure est donc plus sévère que H7.
	measure 'Sections acceptées sans retouche' = DIVIDE([Nombre de sections sans retouche], [Sections rédigées puis approuvées])
		formatString: 0 %
		displayFolder: 2. Productivité et relecture

	/// Formule : médiane des heures entre la première soumission et l'approbation, par livrable.
	/// Pourquoi : le temps gagné à la rédaction est perdu si le livrable attend en relecture.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : heures calendaires ; non filtré par modèle, car un livrable peut en mélanger plusieurs.
	measure 'Délai de validation' = MEDIAN(Relectures[Délai en heures])
		formatString: 0 "h"
		displayFolder: 2. Productivité et relecture

	/// Formule : renvois par le relecteur ÷ soumissions en relecture.
	/// Pourquoi : signale des brouillons qui arrivent trop tôt ou trop fragiles chez le manager.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : non filtré par modèle.
	measure 'Renvois en correction' = DIVIDE(SUM(Relectures[Renvois]), SUM(Relectures[Soumissions]))
		formatString: 0 %
		displayFolder: 2. Productivité et relecture

	/// Formule : (phrases vérifiées de la configuration − celles de la référence B) × 100, en points.
	/// Pourquoi : un modèle plus lourd ou affiné ne se justifie que s'il fait mieux que la référence.
	/// Cible : supérieur à 0 pour justifier un changement ; H7 ne fixe pas de seuil.
	/// Limite : échantillons de tailles différentes : lire avec le nombre de générations.
	measure 'Écart à la référence B' =
			VAR vTaux = [Phrases vérifiées]
			VAR vReference = CALCULATE([Phrases vérifiées], REMOVEFILTERS(Configurations), Configurations[Configuration] = "B")
			RETURN IF(NOT ISBLANK(vTaux) && NOT ISBLANK(vReference), (vTaux - vReference) * 100)
		formatString: +0" pts";-0" pts";"0 pt"
		displayFolder: 3. Comparaison des modèles

	/// Formule : 95e centile de la durée d'un appel de rédaction de section, en secondes.
	/// Pourquoi : au-delà de quelques dizaines de secondes, le consultant cesse d'utiliser l'outil ; cette mesure arbitre qualité contre vitesse.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : appels de section seulement (kpi.py prend tous les appels) ; la latence d'une tentative répétée est répartie à parts égales.
	measure 'Temps de réponse p95' =
			CALCULATE(
			    PERCENTILEX.INC('Appels au modèle', 'Appels au modèle'[Latence en ms], 0.95) / 1000,
			    KEEPFILTERS('Appels au modèle'[Nature] = "section"))
		formatString: 0 "s"
		displayFolder: 3. Comparaison des modèles

	/// Formule : somme des consignes cachées détectées dans les documents importés.
	/// Pourquoi : un document piégé peut détourner le modèle ; chaque alerte demande un examen humain.
	/// Cible : aucun seuil dans H7 ; examiner 100 % des alertes.
	/// Limite : compte les détections, pas les attaques réussies ; non filtré par modèle ni par type de livrable.
	measure 'Alertes d''injection' = IF([Documents analysés] > 0, SUM(Documents[Alertes]) + 0)
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Formule : documents avec au moins une alerte ÷ documents importés.
	/// Pourquoi : situe le risque : incident isolé ou source documentaire à revoir.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	/// Limite : un document est daté de la première génération de sa mission.
	measure 'Documents signalés' = DIVIDE([Nombre de documents signalés] + 0, [Documents analysés])
		formatString: 0 %
		displayFolder: 4. Sécurité et usage

	/// Formule : nombre de livrables distincts approuvés par un manager.
	/// Pourquoi : c'est l'usage qui compte : un brouillon non approuvé ne crée pas de valeur.
	/// Cible : Aucun seuil dans H7 : indicateur de suivi.
	measure 'Livrables approuvés' = DISTINCTCOUNT('Sections approuvées'[Identifiant du livrable])
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Phrases des générations réussies.
	measure 'Phrases générées' = CALCULATE(SUM('Générations'[Phrases produites]), KEEPFILTERS('Générations'[Statut] = "ok"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Phrases validées par le vérificateur.
	measure 'Nombre de phrases vérifiées' = CALCULATE(SUM('Générations'[Phrases validées]), KEEPFILTERS('Générations'[Statut] = "ok"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Phrases en avertissement, à relire.
	measure 'Phrases à vérifier' = CALCULATE(SUM('Générations'[Phrases en avertissement]), KEEPFILTERS('Générations'[Statut] = "ok"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Phrases bloquées par le vérificateur.
	measure 'Phrases rejetées' = CALCULATE(SUM('Générations'[Phrases en échec]), KEEPFILTERS('Générations'[Statut] = "ok"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Contribution de chaque marche de la cascade, des phrases générées aux phrases vérifiées.
	measure 'Variation de phrases' =
			SWITCH(SELECTEDVALUE(Cascade[Ordre]), 1, [Phrases générées], 2, -[Phrases à vérifier], 3, -[Phrases rejetées],
			    [Phrases générées] - [Phrases à vérifier] - [Phrases rejetées])
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Contrôles de citation en anomalie.
	measure Anomalies = CALCULATE(COUNTROWS(Citations), KEEPFILTERS(Citations[Code de contrôle] <> "NONE"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Tentatives de rédaction d'une section, constats exclus.
	measure 'Générations de sections' = CALCULATE(COUNTROWS('Générations'), KEEPFILTERS('Générations'[Nature] = "Section"))
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Générations de sections refusées faute de preuve.
	measure 'Nombre de sections refusées' = CALCULATE(COUNTROWS('Générations'), KEEPFILTERS('Générations'[Nature] = "Section"), KEEPFILTERS('Générations'[Statut] = "refused")) + 0
		formatString: #,0
		displayFolder: 1. Qualité et preuves

	/// Sections distinctes demandées (mission, type de livrable, section).
	measure 'Sections demandées' = CALCULATE(COUNTROWS(SUMMARIZE('Générations', 'Générations'[Clé de mission], 'Générations'[Code du type], 'Générations'[Code de section])), KEEPFILTERS('Générations'[Nature] = "Section"))
		formatString: #,0
		displayFolder: 2. Productivité et relecture

	/// Sections distinctes rédigées au moins une fois.
	measure 'Sections rédigées' = CALCULATE(COUNTROWS(SUMMARIZE('Générations', 'Générations'[Clé de mission], 'Générations'[Code du type], 'Générations'[Code de section])), KEEPFILTERS('Générations'[Nature] = "Section"), KEEPFILTERS('Générations'[Statut] = "ok"))
		formatString: #,0
		displayFolder: 2. Productivité et relecture

	/// Sections approuvées, refus exclus.
	measure 'Sections rédigées puis approuvées' = CALCULATE(COUNTROWS('Sections approuvées'), KEEPFILTERS('Sections approuvées'[Refusée] = 0))
		formatString: #,0
		displayFolder: 2. Productivité et relecture

	/// Sections approuvées mot pour mot.
	measure 'Nombre de sections sans retouche' =
			VAR vRedigees = [Sections rédigées puis approuvées]
			RETURN IF(vRedigees > 0, CALCULATE(COUNTROWS('Sections approuvées'), KEEPFILTERS('Sections approuvées'[Refusée] = 0),
			    KEEPFILTERS('Sections approuvées'[Sans retouche] = 1)) + 0)
		formatString: #,0
		displayFolder: 2. Productivité et relecture

	/// Volume à chaque étape de l'entonnoir, chacune à sa propre date.
	measure 'Sections à l''étape' =
			SWITCH(SELECTEDVALUE('Étapes'[Ordre]), 1, [Sections demandées], 2, [Sections rédigées],
			    3, [Sections rédigées puis approuvées], 4, [Nombre de sections sans retouche])
		formatString: #,0
		displayFolder: 2. Productivité et relecture

	/// Minutes gagnées estimées ÷ 60, refus exclus.
	measure 'Heures gagnées' = CALCULATE(SUM('Sections approuvées'[Minutes gagnées]), KEEPFILTERS('Sections approuvées'[Refusée] = 0)) / 60
		formatString: 0 "h"
		displayFolder: 2. Productivité et relecture

	/// Part moyenne du texte modifiée avant approbation, refus exclus.
	measure 'Part réécrite' = CALCULATE(AVERAGE('Sections approuvées'[Part de texte modifiée]), KEEPFILTERS('Sections approuvées'[Refusée] = 0))
		formatString: 0 %
		displayFolder: 2. Productivité et relecture

	/// Citations dont la source existe dans le dossier ÷ citations produites.
	measure 'Citations valides' = DIVIDE(SUM('Générations'[Citations valides en nombre]), SUM('Générations'[Citations produites]))
		formatString: 0 %
		displayFolder: 3. Comparaison des modèles

	/// Valeur du critère affiché dans chaque petit multiple.
	measure 'Valeur du critère' =
			SWITCH(SELECTEDVALUE('Critères'[Ordre]), 1, [Phrases vérifiées], 2, [Citations valides],
			    3, [Chiffres retrouvés dans la source], 4, [Sections acceptées sans retouche])
		formatString: 0 %
		displayFolder: 3. Comparaison des modèles

	/// Documents importés.
	measure 'Documents analysés' = COUNTROWS(Documents)
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Documents avec au moins une alerte.
	measure 'Nombre de documents signalés' = CALCULATE(COUNTROWS(Documents), KEEPFILTERS(Documents[Alertes] > 0))
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Documents sans alerte.
	measure 'Documents sans alerte' = CALCULATE(COUNTROWS(Documents), KEEPFILTERS(Documents[Alertes] = 0))
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Alertes, missions sans alerte masquées.
	measure 'Alertes par mission' = CALCULATE(SUM(Documents[Alertes]), KEEPFILTERS(Documents[Alertes] > 0))
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Missions avec au moins une génération.
	measure 'Missions actives' = DISTINCTCOUNT('Générations'[Clé de mission])
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	/// Appels de génération, sections et constats.
	measure 'Générations' = COUNTROWS('Générations')
		formatString: #,0
		displayFolder: 4. Sécurité et usage

	measure 'Carte Phrases vérifiées' =
			VAR v = [Phrases vérifiées]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Citations inventées' =
			VAR v = [Citations inventées]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "#,0", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Chiffres retrouvés dans la source' =
			VAR v = [Chiffres retrouvés dans la source]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Sections refusées faute de preuve' =
			VAR v = [Sections refusées faute de preuve]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Temps gagné' =
			VAR v = [Temps gagné]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Temps gagné par livrable' =
			VAR v = [Temps gagné par livrable]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0.0 h", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Sections acceptées sans retouche' =
			VAR v = [Sections acceptées sans retouche]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Délai de validation' =
			VAR v = [Délai de validation]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0.0 h", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Renvois en correction' =
			VAR v = [Renvois en correction]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Alertes d''injection' =
			VAR v = [Alertes d'injection]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "#,0", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Documents signalés' =
			VAR v = [Documents signalés]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "0 %", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Missions actives' =
			VAR v = [Missions actives]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "#,0", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Carte Livrables approuvés' =
			VAR v = [Livrables approuvés]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "#,0", "fr-FR"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Statut Phrases vérifiées' =
			VAR v = [Phrases vérifiées]
			RETURN IF(ISBLANK(v), "Aucune donnée", IF(v >= 0.5, "✓ Au-dessus du plancher de 50 %", "✕ Sous le plancher de 50 %"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur Phrases vérifiées' =
			VAR v = [Phrases vérifiées]
			RETURN IF(ISBLANK(v), "#747480", IF(v >= 0.5, "#1E6B4F", "#B4232F"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Statut Citations inventées' =
			VAR v = [Citations inventées]
			RETURN IF(ISBLANK(v), "Aucune donnée", IF(v <= 0, "✓ Cible atteinte : 0", "✕ Cible : 0"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur Citations inventées' =
			VAR v = [Citations inventées]
			RETURN IF(ISBLANK(v), "#747480", IF(v <= 0, "#1E6B4F", "#B4232F"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Statut Sections acceptées sans retouche' =
			VAR v = [Sections acceptées sans retouche]
			RETURN IF(ISBLANK(v), "Aucune donnée", IF(v >= 0.5, "✓ Cible atteinte : ≥ 50 %", "✕ Cible : ≥ 50 %"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur Sections acceptées sans retouche' =
			VAR v = [Sections acceptées sans retouche]
			RETURN IF(ISBLANK(v), "#747480", IF(v >= 0.5, "#1E6B4F", "#B4232F"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Statut Temps gagné' =
			VAR v = [Temps gagné]
			RETURN IF(ISBLANK(v), "Aucune donnée", IF(v >= 0.3, "✓ Cible atteinte : ≥ 30 %", "✕ Cible : ≥ 30 %"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur Temps gagné' =
			VAR v = [Temps gagné]
			RETURN IF(ISBLANK(v), "#747480", IF(v >= 0.3, "#1E6B4F", "#B4232F"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Bandeau données' =
			IF(CALCULATE(MAX(Missions[Est une démonstration]), REMOVEFILTERS()) = 1,
			    "Données de démonstration · valeurs inventées", " ")
		displayFolder: 9. Présentation
		isHidden

	measure Verdict =
			VAR vCitations = [Citations inventées]
			VAR vRetouche = [Sections acceptées sans retouche]
			VAR vTemps = [Temps gagné]
			VAR vAtteints = IF(NOT ISBLANK(vCitations) && vCitations <= 0, 1, 0)
			    + IF(vRetouche >= 0.5, 1, 0) + IF(vTemps >= 0.3, 1, 0)
			RETURN IF(ISBLANK(vCitations) || ISBLANK(vRetouche) || ISBLANK(vTemps),
			    "Pas assez de données dans cette sélection pour conclure",
			    vAtteints & IF(vAtteints > 1, " critères atteints", " critère atteint") & " sur 3")
		displayFolder: 9. Présentation
		isHidden

	measure 'Détail du verdict' =
			VAR vCitations = [Citations inventées]
			VAR vRetouche = [Sections acceptées sans retouche]
			VAR vTemps = [Temps gagné]
			RETURN IF(ISBLANK(vCitations) || ISBLANK(vRetouche) || ISBLANK(vTemps), " ",
			    IF(vTemps >= 0.3, "✓", "✕") & " Temps gagné  ·  "
			    & IF(vRetouche >= 0.5, "✓", "✕") & " Texte réutilisable  ·  "
			    & IF(vCitations <= 0, "✓", "✕") & " Zéro citation inventée")
		displayFolder: 9. Présentation
		isHidden

	measure 'Tuile qualité' =
			VAR vTotal = [Phrases générées]
			RETURN IF(ISBLANK(vTotal), "—", FORMAT(vTotal - [Nombre de phrases vérifiées], "#,0", "fr-FR") & " phrases à revoir")
		displayFolder: 9. Présentation
		isHidden

	measure 'Tuile productivité' =
			VAR v = [Heures gagnées]
			RETURN IF(ISBLANK(v), "—", FORMAT(v, "#,0", "fr-FR") & " h gagnées")
		displayFolder: 9. Présentation
		isHidden

	measure 'Tuile modèles' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Configurations[Configuration]), "@v", [Phrases vérifiées]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, Configurations[Configuration], ASC)
			VAR vNom = MAXX(vPremier, Configurations[Configuration])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "—", vNom & " en tête à " & FORMAT(vValeur, "0 %"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Tuile sécurité' =
			VAR v = [Alertes d'injection]
			RETURN IF(ISBLANK(v), "—", v & IF(v > 1, " alertes", " alerte"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre cascade' =
			VAR vTotal = [Phrases générées]
			VAR vOk = [Nombre de phrases vérifiées] + 0
			RETURN IF(ISBLANK(vTotal), "Aucune phrase générée dans cette sélection",
			    vOk & " phrases sur " & vTotal & " sont vérifiées")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre anomalies' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Citations[Anomalie]), "@v", [Anomalies]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, Citations[Anomalie], ASC)
			VAR vNom = MAXX(vPremier, Citations[Anomalie])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Aucune anomalie dans cette sélection",
			    "« " & vNom & " » est la première anomalie (" & vValeur & " cas)")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre sections fragiles' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED('Générations'[Section]), "@v", [Phrases vérifiées]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], ASC, 'Générations'[Section], ASC)
			VAR vNom = MAXX(vPremier, 'Générations'[Section])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Aucune section rédigée dans cette sélection",
			    "« " & vNom & " » est la section la moins vérifiée (" & FORMAT(vValeur, "0 %") & ")")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre entonnoir' =
			VAR vDebut = [Sections demandées]
			VAR vFin = [Nombre de sections sans retouche]
			RETURN IF(ISBLANK(vDebut) || ISBLANK(vFin), "Des sections demandées aux sections réutilisées",
			    vFin & " sections sur " & vDebut & " vont au bout sans retouche")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre retouches' =
			VAR vTotal = [Sections rédigées puis approuvées]
			VAR vModifiees = vTotal - [Nombre de sections sans retouche]
			RETURN IF(ISBLANK(vTotal), "Aucune section approuvée dans cette sélection",
			    vModifiees & " sections approuvées sur " & vTotal & " ont été retouchées")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre réécriture' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED('Sections approuvées'[Section]), "@v", [Part réécrite]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, 'Sections approuvées'[Section], ASC)
			VAR vNom = MAXX(vPremier, 'Sections approuvées'[Section])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Aucune section approuvée dans cette sélection",
			    "« " & vNom & " » demande le plus de réécriture")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre critères' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Configurations[Configuration]), "@v", [Phrases vérifiées]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, Configurations[Configuration], ASC)
			VAR vNom = MAXX(vPremier, Configurations[Configuration])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Aucune configuration à comparer",
			    "La configuration " & vNom & " vérifie le plus de phrases (" & FORMAT(vValeur, "0 %") & ")")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre bilan' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Configurations[Configuration et modèle]), "@v", [Écart à la référence B]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, Configurations[Configuration et modèle], ASC)
			VAR vNom = MAXX(vPremier, Configurations[Configuration et modèle])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Bilan de chaque configuration",
			    IF(ROUND(vValeur, 0) > 0,
			        LEFT(vNom, 1) & " devance la référence B de " & FORMAT(vValeur, "0") & " points",
			        "Aucune configuration ne devance la référence B"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre arbitrage' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Configurations[Configuration]), "@q", [Phrases vérifiées],
			    "@t", [Temps de réponse p95]), NOT ISBLANK([@q]) && NOT ISBLANK([@t]))
			VAR vFiable = MAXX(TOPN(1, vListe, [@q], DESC, Configurations[Configuration], ASC), Configurations[Configuration])
			VAR vRapide = MAXX(TOPN(1, vListe, [@t], ASC, Configurations[Configuration], ASC), Configurations[Configuration])
			RETURN IF(ISBLANK(vFiable), "Qualité et vitesse",
			    IF(vFiable = vRapide, vFiable & " est la plus fiable et la plus rapide",
			        vFiable & " est la plus fiable, " & vRapide & " la plus rapide"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre alertes' =
			VAR vAlertes = [Alertes d'injection] + 0
			VAR vMissions = CALCULATE(DISTINCTCOUNT(Documents[Clé de mission]), KEEPFILTERS(Documents[Alertes] > 0))
			RETURN IF(vAlertes = 0, "Aucune alerte d'injection dans cette sélection",
			    vAlertes & IF(vAlertes > 1, " alertes réparties sur ", " alerte sur ")
			    & vMissions & IF(vMissions > 1, " missions", " mission") & " à examiner")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre formats' =
			VAR vListe = FILTER(ADDCOLUMNS(ALLSELECTED(Documents[Format]), "@v", [Nombre de documents signalés]), NOT ISBLANK([@v]))
			VAR vPremier = TOPN(1, vListe, [@v], DESC, Documents[Format], ASC)
			VAR vNom = MAXX(vPremier, Documents[Format])
			VAR vValeur = MAXX(vPremier, [@v])
			RETURN IF(ISBLANK(vNom), "Aucun format de document signalé",
			    IF(COUNTROWS(FILTER(vListe, [@v] = vValeur)) > 1, "Plusieurs formats sont touchés à égalité",
			        vNom & " est le format le plus souvent signalé"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre usage' =
			VAR vTotal = [Générations] + 0
			VAR vClients = DISTINCTCOUNT('Générations'[Client d'origine])
			RETURN IF(vTotal = 0, "Aucune génération dans cette sélection",
			    vTotal & " générations pour " & vClients & IF(vClients > 1, " clients", " client"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Fond de taux' =
			VAR v = [Phrases vérifiées]
			RETURN IF(NOT ISBLANK(v), SWITCH(TRUE(), v < 0.5, "#F6D5D8", v >= 0.8, "#FFFFFF", "#E9E9EF"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur d''écart' =
			VAR v = ROUND([Écart à la référence B], 0)
			RETURN SWITCH(TRUE(), v > 0, "#1E6B4F", v < 0, "#B4232F", "#2E2E38")
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur du critère' =
			VAR v = [Valeur du critère]
			VAR vMax = MAXX(ALLSELECTED(Configurations[Configuration]), [Valeur du critère])
			RETURN IF(ROUND(v, 2) = ROUND(vMax, 2), "#FFE600", "#C4C4CD")
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de réécriture' =
			VAR v = [Part réécrite]
			VAR vMax = MAXX(ALLSELECTED('Sections approuvées'[Section]), [Part réécrite])
			RETURN IF(v = vMax, "#FFE600", "#C4C4CD")
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de retouche' = IF(SELECTEDVALUE('Sections approuvées'[Ordre de retouche]) = 1, "#FFE600", "#C4C4CD")
		displayFolder: 9. Présentation
		isHidden

	column Colonne
		dataType: string
		isHidden
		sourceColumn: Colonne
		summarizeBy: none

	partition Indicateurs = m
		mode: import
		source =
				let
				    Vide = #table(type table [Colonne = text], {})
				in
				    Vide
