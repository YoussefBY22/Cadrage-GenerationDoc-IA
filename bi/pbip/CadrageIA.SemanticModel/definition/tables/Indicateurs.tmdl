table Indicateurs

	/// Formule : livrables en brouillon ou renvoyés, dont les renvois pas encore resoumis.
	/// Décision : Par quel livrable commencer
	/// Cible : aucun seuil dans H7
	/// Situation à la date des données : ne suit pas la période.
	measure 'Livrables à traiter' = CALCULATE(COUNTROWS(Livrables), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"})) + 0
		formatString: #,0
		displayFolder: Consultant

	measure 'Renvois à reprendre' = CALCULATE(COUNTROWS(Livrables), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"}), KEEPFILTERS(Livrables[Renvoyé] = 1)) + 0
		formatString: #,0
		displayFolder: Consultant

	/// Formule : phrases des livrables chez le consultant dont la source est absente du dossier, ou rejetées par le vérificateur et inchangées depuis.
	/// Décision : Quoi corriger avant de soumettre
	/// Cible : 0 avant de soumettre (règle du produit)
	/// Situation à la date des données : ne suit pas la période.
	/// Limite : une phrase modifiée n'est pas revérifiée ici : seule sa source est contrôlée.
	measure 'Phrases bloquantes à corriger' = CALCULATE(SUM(Livrables[Phrases bloquantes]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"})) + 0
		formatString: #,0
		displayFolder: Consultant

	measure 'Sections rédigées puis approuvées' = CALCULATE(COUNTROWS('Sections approuvées'), KEEPFILTERS('Sections approuvées'[Refusée] = 0)) + 0
		formatString: #,0
		displayFolder: Consultant

	measure 'Nombre de sections sans retouche' = CALCULATE(COUNTROWS('Sections approuvées'), KEEPFILTERS('Sections approuvées'[Refusée] = 0), KEEPFILTERS('Sections approuvées'[Sans retouche] = 1)) + 0
		formatString: #,0
		displayFolder: Consultant

	/// Formule : sections approuvées mot pour mot ÷ sections rédigées puis approuvées (refus exclus).
	/// Décision : Partir du premier jet ou le retravailler
	/// Cible : au moins 50 % (H7)
	/// Flux : suit la période.
	/// Limite : H7 raisonne par phrase, l'entrepôt par section (plus sévère). Pas de taux sous 30 sections.
	measure 'Sections acceptées sans retouche' =
			VAR vN = [Sections rédigées puis approuvées]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, BLANK(), IF(vN >= 30, DIVIDE([Nombre de sections sans retouche], vN)))
		formatString: 0 %
		displayFolder: Consultant

	/// Formule : livrables en relecture, dont ceux qui attendent depuis plus de 48 h.
	/// Décision : Qui relit quoi aujourd'hui
	/// Cible : 0 au-delà de 48 h (règle de pilotage, hors H7)
	/// Situation à la date des données : ne suit pas la période.
	measure 'Livrables à valider' = CALCULATE(COUNTROWS(Livrables), KEEPFILTERS(Livrables[Code d'état] IN {"in_review"})) + 0
		formatString: #,0
		displayFolder: Responsable

	measure 'Relectures en retard' = CALCULATE(COUNTROWS(Livrables), KEEPFILTERS(Livrables[Code d'état] IN {"in_review"}), KEEPFILTERS(Livrables[Heures dans l'état] > 48)) + 0
		formatString: #,0
		displayFolder: Responsable

	/// Formule : phrases bloquantes, non acquittées, des livrables en relecture.
	/// Décision : Quoi vérifier en premier
	/// Cible : 0 à l'approbation (règle du produit)
	/// Situation à la date des données : ne suit pas la période.
	measure 'Phrases bloquantes à vérifier' = CALCULATE(SUM(Livrables[Phrases bloquantes]), KEEPFILTERS(Livrables[Code d'état] IN {"in_review"})) + 0
		formatString: #,0
		displayFolder: Responsable

	measure 'Livrables avec délai' = CALCULATE(COUNT(Livrables[Délai en heures]), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date])) + 0
		formatString: #,0
		displayFolder: Responsable

	/// Formule : médiane des heures entre la première soumission et l'approbation.
	/// Décision : Renforcer ou répartir la relecture
	/// Cible : aucun seuil dans H7
	/// Flux : suit la période.
	/// Limite : heures calendaires ; pas de valeur sous 30 livrables ; ne voit pas ce qui attend encore.
	measure 'Délai de validation' = IF([Livrables avec délai] >= 30, CALCULATE(MEDIAN(Livrables[Délai en heures]), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date])))
		formatString: 0 "h"
		displayFolder: Responsable

	measure 'Premières relectures décidées' = CALCULATE(COUNT(Livrables[Renvoyé en première relecture]), USERELATIONSHIP(Livrables[Clé de soumission], Calendrier[Clé de date])) + 0
		formatString: #,0
		displayFolder: Responsable

	measure 'Nombre de renvois en première relecture' = CALCULATE(SUM(Livrables[Renvoyé en première relecture]), USERELATIONSHIP(Livrables[Clé de soumission], Calendrier[Clé de date])) + 0
		formatString: #,0
		displayFolder: Responsable

	/// Formule : livrables renvoyés à leur première relecture ÷ livrables dont la première relecture est décidée.
	/// Décision : Revoir la préparation avant soumission
	/// Cible : aucun seuil dans H7
	/// Flux : suit la période.
	/// Limite : pas de taux sous 30 décisions.
	measure 'Renvois à la première relecture' =
			VAR vN = [Premières relectures décidées]
			RETURN IF(vN >= 30, DIVIDE([Nombre de renvois en première relecture], vN))
		formatString: 0 %
		displayFolder: Responsable

	measure 'Livrables approuvés' = CALCULATE(COUNTROWS(Livrables), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date])) + 0
		formatString: #,0
		displayFolder: Rapport

	measure 'Livrables mesurés' = CALCULATE(COUNT(Livrables[Citations finales]), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date])) + 0
		formatString: #,0
		displayFolder: Rapport

	measure 'Citations approuvées' = CALCULATE(SUM(Livrables[Citations finales]), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date]))
		formatString: #,0
		displayFolder: Rapport

	/// Formule : citations de la version approuvée dont la source n'est pas dans le dossier.
	/// Décision : Autoriser ou bloquer l'envoi au client
	/// Cible : 0 (H7)
	/// Flux : suit la période.
	/// Limite : « non mesuré » si la version approuvée n'a pas de sections lisibles ; qu'une source existe ne prouve pas qu'elle soutient la phrase.
	measure 'Citations sans source après approbation' = IF(MAX('Source des données'[Est une démonstration]) = 1, BLANK(), IF([Livrables mesurés] > 0, CALCULATE(SUM(Livrables[Citations sans source]), KEEPFILTERS(Livrables[Code d'état] IN {"approved"}), USERELATIONSHIP(Livrables[Clé d'approbation], Calendrier[Clé de date])) + 0))
		formatString: #,0
		displayFolder: Rapport

	measure 'Citations générées' = CALCULATE(SUM('Générations'[Citations produites]), KEEPFILTERS('Générations'[Statut] = "ok"), KEEPFILTERS('Générations'[Code du type] <> "findings")) + 0
		formatString: #,0
		displayFolder: Rapport

	measure 'Nombre de citations sans source avant relecture' = [Citations générées] - CALCULATE(SUM('Générations'[Citations valides en nombre]), KEEPFILTERS('Générations'[Statut] = "ok"), KEEPFILTERS('Générations'[Code du type] <> "findings"))
		formatString: #,0
		displayFolder: Rapport

	/// Formule : citations générées dont la source n'est pas dans le dossier ÷ citations générées.
	/// Décision : Régler la recherche ou le modèle
	/// Cible : aucune : le critère H7 porte sur ce qui reste après approbation
	/// Flux : suit la période.
	measure 'Citations sans source avant relecture' = IF(MAX('Source des données'[Est une démonstration]) = 1, BLANK(), IF([Citations générées] >= 30, DIVIDE([Nombre de citations sans source avant relecture], [Citations générées])))
		formatString: 0 %
		displayFolder: Rapport

	measure 'Phrases générées' = CALCULATE(SUM('Générations'[Phrases produites]), KEEPFILTERS('Générations'[Statut] = "ok"), KEEPFILTERS('Générations'[Code du type] <> "findings")) + 0
		formatString: #,0
		displayFolder: Rapport

	measure 'Nombre de phrases vérifiées' = CALCULATE(SUM('Générations'[Phrases validées]), KEEPFILTERS('Générations'[Statut] = "ok"), KEEPFILTERS('Générations'[Code du type] <> "findings")) + 0
		formatString: #,0
		displayFolder: Rapport

	/// Formule : phrases validées par le vérificateur ÷ phrases générées (TPV).
	/// Décision : Effort de relecture à prévoir
	/// Cible : aucune : H7 ne fixe pas de seuil sur le TPV
	/// Flux : suit la période.
	/// Limite : mesure l'ancrage dans les sources, pas la vérité.
	measure 'Phrases vérifiées' = IF(MAX('Source des données'[Est une démonstration]) = 1, BLANK(), IF([Phrases générées] >= 30, DIVIDE([Nombre de phrases vérifiées], [Phrases générées])))
		formatString: 0 %
		displayFolder: Rapport

	/// Formule : consignes cachées détectées dans les documents importés.
	/// Décision : Examiner chaque passage signalé
	/// Cible : examiner toutes les alertes
	/// Situation à la date des données : ne suit pas la période.
	/// Limite : une alerte est une détection, pas une attaque réussie.
	measure 'Alertes d''injection' = SUM(Documents[Alertes]) + 0
		formatString: #,0
		displayFolder: Administration

	measure 'Documents analysés' = COUNTROWS(Documents)
		formatString: #,0
		displayFolder: Administration

	measure 'Nombre de documents signalés' = IF([Documents analysés] > 0, CALCULATE(COUNTROWS(Documents), KEEPFILTERS(Documents[Alertes] > 0)) + 0)
		formatString: #,0
		displayFolder: Administration

	/// Formule : documents avec au moins une alerte d'injection ÷ documents importés.
	/// Décision : Revoir une source documentaire
	/// Cible : examiner toutes les alertes
	/// Situation à la date des données : ne suit pas la période.
	/// Limite : pas de taux sous 30 documents.
	measure 'Documents signalés' = IF([Documents analysés] >= 30, DIVIDE([Nombre de documents signalés], [Documents analysés]))
		formatString: 0 %
		displayFolder: Administration

	measure 'Reco rang' =
			VAR vPriorite = SELECTEDVALUE('Règles'[Priorité])
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), TRUE()), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			VAR vRang = COUNTROWS(FILTER(vListe, 'Règles'[Priorité] <= vPriorite)) + 0
			RETURN IF(COUNTROWS(FILTER(vListe, 'Règles'[Priorité] = vPriorite)) > 0
			    && vRang <= 3, vRang)
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco nombre' =
			IF(NOT ISBLANK([Reco rang]), VAR vCode = SELECTEDVALUE('Règles'[Code de règle])
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco pour' = IF(NOT ISBLANK([Reco rang]), SELECTEDVALUE('Règles'[Acteur]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco action' = IF(NOT ISBLANK([Reco rang]), SELECTEDVALUE('Règles'[Action]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco état' =
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), TRUE()), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			RETURN IF(COUNTROWS(vListe) + 0 = 0, "Aucune action", " ")
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco rang (consultant)' =
			VAR vPriorite = SELECTEDVALUE('Règles'[Priorité])
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), 'Règles'[Acteur] = "Consultant"), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			VAR vRang = COUNTROWS(FILTER(vListe, 'Règles'[Priorité] <= vPriorite)) + 0
			RETURN IF(COUNTROWS(FILTER(vListe, 'Règles'[Priorité] = vPriorite)) > 0
			    && vRang <= 3, vRang)
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco nombre (consultant)' =
			IF(NOT ISBLANK([Reco rang (consultant)]), VAR vCode = SELECTEDVALUE('Règles'[Code de règle])
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco action (consultant)' = IF(NOT ISBLANK([Reco rang (consultant)]), SELECTEDVALUE('Règles'[Action]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco état (consultant)' =
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), 'Règles'[Acteur] = "Consultant"), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			RETURN IF(COUNTROWS(vListe) + 0 = 0, "Aucune action", " ")
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco rang (responsable)' =
			VAR vPriorite = SELECTEDVALUE('Règles'[Priorité])
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), 'Règles'[Acteur] = "Responsable"), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			VAR vRang = COUNTROWS(FILTER(vListe, 'Règles'[Priorité] <= vPriorite)) + 0
			RETURN IF(COUNTROWS(FILTER(vListe, 'Règles'[Priorité] = vPriorite)) > 0
			    && vRang <= 3, vRang)
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco nombre (responsable)' =
			IF(NOT ISBLANK([Reco rang (responsable)]), VAR vCode = SELECTEDVALUE('Règles'[Code de règle])
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco action (responsable)' = IF(NOT ISBLANK([Reco rang (responsable)]), SELECTEDVALUE('Règles'[Action]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Reco état (responsable)' =
			VAR vListe = FILTER(ADDCOLUMNS(FILTER(ALL('Règles'), 'Règles'[Acteur] = "Responsable"), "@n",
			    VAR vCode = 'Règles'[Code de règle]
			    RETURN CALCULATE(COUNTROWS(Actions), Actions[Code de règle signalée] = vCode)), [@n] > 0)
			RETURN IF(COUNTROWS(vListe) + 0 = 0, "Aucune action", " ")
		displayFolder: 9. Présentation
		isHidden

	measure 'Soumissions réelles' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			VAR vCle = MAXX(vPrevision, 'Prévisions'[Clé de prévision])
			RETURN CALCULATE(SUM('Série de prévision'[Réel]), 'Série de prévision'[Clé de prévision] = vCle)
		displayFolder: 9. Présentation
		isHidden

	measure 'Prévision' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			VAR vCle = MAXX(vPrevision, 'Prévisions'[Clé de prévision])
			RETURN CALCULATE(SUM('Série de prévision'[Point prévu]), 'Série de prévision'[Clé de prévision] = vCle)
		displayFolder: 9. Présentation
		isHidden

	measure 'Borne basse' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			VAR vCle = MAXX(vPrevision, 'Prévisions'[Clé de prévision])
			RETURN CALCULATE(SUM('Série de prévision'[Borne basse prévue]), 'Série de prévision'[Clé de prévision] = vCle)
		displayFolder: 9. Présentation
		isHidden

	measure 'Borne haute' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			VAR vCle = MAXX(vPrevision, 'Prévisions'[Clé de prévision])
			RETURN CALCULATE(SUM('Série de prévision'[Borne haute prévue]), 'Série de prévision'[Clé de prévision] = vCle)
		displayFolder: 9. Présentation
		isHidden

	measure 'Prévision valeur' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			RETURN SWITCH(vStatut, "ok", FORMAT(MAXX(vPrevision, 'Prévisions'[Point]), "0", "fr-FR") & " soumissions attendues (" & FORMAT(MAXX(vPrevision, 'Prévisions'[Bas]), "0", "fr-FR") & " à " & FORMAT(MAXX(vPrevision, 'Prévisions'[Haut]), "0", "fr-FR") & ")",
			    "not_better", "Pas de prévision fiable", "Historique insuffisant")
		displayFolder: 9. Présentation
		isHidden

	measure 'Prévision méthode' =
			VAR vClient = SELECTEDVALUE('Choix du client'[Client choisi], "Tous")
			VAR vType = SELECTEDVALUE('Choix du type'[Type choisi], "Tous")
			VAR vPersonne = SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous")
			VAR vCandidats = FILTER(ALL('Prévisions'), 'Prévisions'[Périmètre client] = vClient
			    && 'Prévisions'[Périmètre type] = vType && (vPersonne = "Tous"
			        || 'Prévisions'[Périmètre consultant] = vPersonne))
			VAR vPrevision = TOPN(1, vCandidats, 'Prévisions'[Rang de périmètre], ASC, 'Prévisions'[Clé de prévision], ASC)
			VAR vStatut = MAXX(vPrevision, 'Prévisions'[Statut de prévision])
			RETURN IF(vStatut <> "ok", " ", IF(MAX('Source des données'[Est une démonstration]) = 1, "Fiabilité non mesurée",
			    FORMAT(MAXX(vPrevision, 'Prévisions'[Soumissions]), "0", "fr-FR") & " soumissions observées"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Mention simulation' =
			IF(MAX('Source des données'[Est une démonstration]) = 1,
			    "Simulation sur données inventées", " ")
		displayFolder: 9. Présentation
		isHidden

	measure 'Bandeau données' = IF(MAX('Source des données'[Est une démonstration]) = 1, "Données de démonstration · valeurs inventées", " ")
		displayFolder: 9. Présentation
		isHidden

	measure 'Pied de page' = IF(MAX('Source des données'[Est une démonstration]) = 1, "Traitement local · jeu inventé", "Traitement local · confidentiel")
		displayFolder: 9. Présentation
		isHidden

	measure 'Sous-titre synthese' =
			VAR vDate = MAX('Source des données'[Date de situation])
			VAR vJour = MID(vDate, 9, 2) & "/" & MID(vDate, 6, 2) & "/" & LEFT(vDate, 4)
			RETURN "Client : " & SELECTEDVALUE('Choix du client'[Client choisi], "Tous") & "  ·  type : " & SELECTEDVALUE('Choix du type'[Type choisi], "Tous") & "  ·  consultant : " & SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous") & "  |  " & SELECTEDVALUE('Choix de période'[Période choisie], "Tout l'historique") & ", situation au " & vJour
		displayFolder: 9. Présentation
		isHidden

	measure 'Sous-titre production' =
			VAR vDate = MAX('Source des données'[Date de situation])
			VAR vJour = MID(vDate, 9, 2) & "/" & MID(vDate, 6, 2) & "/" & LEFT(vDate, 4)
			RETURN "Client : " & SELECTEDVALUE('Choix du client'[Client choisi], "Tous") & "  ·  type : " & SELECTEDVALUE('Choix du type'[Type choisi], "Tous") & "  ·  consultant : " & SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous") & "  |  " & SELECTEDVALUE('Choix de période'[Période choisie], "Tout l'historique") & ", situation au " & vJour
		displayFolder: 9. Présentation
		isHidden

	measure 'Sous-titre validation' =
			VAR vDate = MAX('Source des données'[Date de situation])
			VAR vJour = MID(vDate, 9, 2) & "/" & MID(vDate, 6, 2) & "/" & LEFT(vDate, 4)
			RETURN "Client : " & SELECTEDVALUE('Choix du client'[Client choisi], "Tous") & "  ·  type : " & SELECTEDVALUE('Choix du type'[Type choisi], "Tous") & "  ·  consultant : " & SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous") & "  |  " & SELECTEDVALUE('Choix de période'[Période choisie], "Tout l'historique") & ", situation au " & vJour
		displayFolder: 9. Présentation
		isHidden

	measure 'Sous-titre administration' =
			VAR vDate = MAX('Source des données'[Date de situation])
			VAR vJour = MID(vDate, 9, 2) & "/" & MID(vDate, 6, 2) & "/" & LEFT(vDate, 4)
			RETURN "Client : " & SELECTEDVALUE('Choix du client'[Client choisi], "Tous") & "  ·  type : " & SELECTEDVALUE('Choix du type'[Type choisi], "Tous") & "  ·  consultant : " & SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous") & "  |  " & SELECTEDVALUE('Choix de période'[Période choisie], "Tout l'historique") & ", situation au " & vJour
		displayFolder: 9. Présentation
		isHidden

	measure 'Filtres du rapport' =
			VAR vDate = MAX('Source des données'[Date de situation])
			VAR vJour = MID(vDate, 9, 2) & "/" & MID(vDate, 6, 2) & "/" & LEFT(vDate, 4)
			RETURN "Client : " & SELECTEDVALUE('Choix du client'[Client choisi], "Tous") & "  ·  type : " & SELECTEDVALUE('Choix du type'[Type choisi], "Tous") & "  ·  consultant : " & SELECTEDVALUE('Choix du consultant'[Consultant choisi], "Tous") & "  |  " & SELECTEDVALUE('Choix de période'[Période choisie], "Tout l'historique") & ", situation au " & vJour
		displayFolder: 9. Présentation
		isHidden

	measure 'Constat synthese' =
			VAR vFile = [Livrables à valider]
			VAR vReste = [Citations sans source après approbation]
			RETURN IF(vFile = 0, "Aucune relecture en attente",
			    vFile & " à valider, dont " & [Relectures en retard] & " en retard")
			    & IF(vReste > 0, " · " & vReste & " sans source après approbation", "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Constat production' =
			VAR vTodo = [Livrables à traiter]
			RETURN IF(vTodo = 0, "Aucun livrable à traiter",
			    vTodo & " à traiter · " & [Renvois à reprendre] & IF([Renvois à reprendre] > 1, " renvoyés", " renvoyé"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Constat validation' =
			VAR vN = [Phrases bloquantes à vérifier]
			RETURN IF([Livrables à valider] = 0, "Aucune relecture en attente",
			    [Relectures en retard] & " en retard · " & vN & IF(vN > 1, " phrases bloquantes", " phrase bloquante"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Constat administration' =
			VAR vAlertes = [Alertes d'injection]
			RETURN [Banc décision] & " · " & vAlertes & IF(vAlertes > 1, " alertes", " alerte") & " à examiner"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Livrables à traiter' = "dont " & [Renvois à reprendre] & IF([Renvois à reprendre] > 1, " renvoyés", " renvoyé")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Phrases bloquantes à corriger' = "sur " & [Livrables à traiter] & IF([Livrables à traiter] > 1, " livrables", " livrable") & " à traiter"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Sections acceptées sans retouche' =
			VAR vPart = [Nombre de sections sans retouche] + 0
			VAR vN = [Sections rédigées puis approuvées] + 0
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, " ", IF(vN < 30, "Effectif insuffisant (n = " & vN & ")", FORMAT(vPart, "#,0", "fr-FR") & " sur " & FORMAT(vN, "#,0", "fr-FR") & " sections"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Livrables à valider' = "dont " & [Relectures en retard] & " en retard"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Délai de validation' =
			VAR vN = [Livrables avec délai]
			RETURN IF(vN < 30, "Effectif insuffisant (n = " & vN & ")",
			    "médiane, n = " & vN & " livrables")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Renvois à la première relecture' =
			VAR vPart = [Nombre de renvois en première relecture] + 0
			VAR vN = [Premières relectures décidées] + 0
			RETURN IF(vN < 30, "Effectif insuffisant (n = " & vN & ")", FORMAT(vPart, "#,0", "fr-FR") & " sur " & FORMAT(vN, "#,0", "fr-FR") & " relectures")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Phrases bloquantes à vérifier' = "sur " & [Livrables à valider] & IF([Livrables à valider] > 1, " livrables", " livrable") & " en relecture"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Citations sans source après approbation' =
			VAR vN = [Livrables mesurés]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, " ", IF(vN = 0, "Non mesuré", "sur " & FORMAT([Citations approuvées], "#,0", "fr-FR") & " citations, " & vN & IF(vN > 1, " livrables mesurés", " livrable mesuré")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Citations sans source avant relecture' =
			VAR vPart = [Nombre de citations sans source avant relecture] + 0
			VAR vN = [Citations générées] + 0
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, " ", IF(vN < 30, "Effectif insuffisant (n = " & vN & ")", FORMAT(vPart, "#,0", "fr-FR") & " sur " & FORMAT(vN, "#,0", "fr-FR") & " citations"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Phrases vérifiées' =
			VAR vPart = [Nombre de phrases vérifiées] + 0
			VAR vN = [Phrases générées] + 0
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, " ", IF(vN < 30, "Effectif insuffisant (n = " & vN & ")", FORMAT(vPart, "#,0", "fr-FR") & " sur " & FORMAT(vN, "#,0", "fr-FR") & " phrases"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Documents signalés' =
			VAR vPart = [Nombre de documents signalés] + 0
			VAR vN = [Documents analysés] + 0
			RETURN IF(vN < 30, "Effectif insuffisant (n = " & vN & ")", FORMAT(vPart, "#,0", "fr-FR") & " sur " & FORMAT(vN, "#,0", "fr-FR") & " documents")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note Alertes d''injection' = "dans " & ([Nombre de documents signalés] + 0) & " documents"
		displayFolder: 9. Présentation
		isHidden

	measure 'À traiter état' = CALCULATE(SELECTEDVALUE(Livrables[État]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"}))
		displayFolder: 9. Présentation
		isHidden

	measure 'À traiter motif' = IF(NOT ISBLANK([À traiter état]), COALESCE(SELECTEDVALUE(Livrables[Motif du renvoi]), "—"))
		displayFolder: 9. Présentation
		isHidden

	measure 'À traiter bloquantes' = IF(NOT ISBLANK([À traiter état]), SUM(Livrables[Phrases bloquantes]) + 0)
		displayFolder: 9. Présentation
		isHidden

	measure 'À traiter sans preuve' = IF(NOT ISBLANK([À traiter état]), SUM(Livrables[Sections sans preuve]) + 0)
		displayFolder: 9. Présentation
		isHidden

	measure 'À traiter inactivité' = IF(NOT ISBLANK([À traiter état]), MAX(Livrables[Heures sans activité]) / 24)
		formatString: 0 "j"
		displayFolder: 9. Présentation
		isHidden

	measure 'Section priorité' =
			VAR v = CALCULATE(SUM('Sections courantes'[Priorité de section]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"}))
			RETURN IF(v > 0, v)
		displayFolder: 9. Présentation
		isHidden

	measure 'Section bloquantes' = IF(NOT ISBLANK([Section priorité]), CALCULATE(SUM('Sections courantes'[Bloquantes]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"})) + 0)
		displayFolder: 9. Présentation
		isHidden

	measure 'Section sans source' = IF(NOT ISBLANK([Section priorité]), CALCULATE(SUM('Sections courantes'[Sans source]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"})) + 0)
		displayFolder: 9. Présentation
		isHidden

	measure 'Section refus' = IF(NOT ISBLANK([Section priorité]), IF(CALCULATE(SUM('Sections courantes'[Refus]), KEEPFILTERS(Livrables[Code d'état] IN {"draft", "rejected"})) > 0, "Compléter", "Corriger"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Charge en relecture' =
			VAR v = [Livrables à valider]
			RETURN IF(v > 0, v)
		displayFolder: 9. Présentation
		isHidden

	measure 'Charge chez le consultant' =
			VAR v = [Livrables à traiter]
			RETURN IF(v > 0, v)
		displayFolder: 9. Présentation
		isHidden

	measure 'File attente' = CALCULATE(MAX(Livrables[Heures dans l'état]), KEEPFILTERS(Livrables[Code d'état] IN {"in_review"})) / 24
		formatString: 0 "j"
		displayFolder: 9. Présentation
		isHidden

	measure 'File priorité' = IF(NOT ISBLANK([File attente]), [File attente] * (1 + IF(MAX('Source des données'[Est une démonstration]) = 1, 0, COALESCE(MAX(Livrables[Risque]), 0))))
		formatString: #,0
		displayFolder: 9. Présentation
		isHidden

	measure 'File consultant' = IF(NOT ISBLANK([File attente]), CALCULATE(SELECTEDVALUE(Personnes[Consultant]), CROSSFILTER(Livrables[Clé de consultant], Personnes[Clé de personne], BOTH)))
		displayFolder: 9. Présentation
		isHidden

	measure 'File bloquantes' = IF(NOT ISBLANK([File attente]), SUM(Livrables[Phrases bloquantes]) + 0)
		displayFolder: 9. Présentation
		isHidden

	measure 'File risque' =
			IF(NOT ISBLANK([File attente]), IF(MAX('Source des données'[Est une démonstration]) = 1, "Non mesuré", IF(ISBLANK(MAX(Livrables[Risque])), "Non mesuré",
			    FORMAT(MAX(Livrables[Risque]), "0 %") & " (n = " & MAX(Livrables[Risque effectif]) & ")")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur d''attente' =
			VAR v = [File attente]
			RETURN IF(NOT ISBLANK(v), IF(v * 24 > 48, "#F6D5D8", "#FFFFFF"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de blocage' = IF([File bloquantes] > 0, "#E9E9EF", "#FFFFFF")
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de correction' = IF([À traiter bloquantes] > 0, "#F6D5D8", "#FFFFFF")
		displayFolder: 9. Présentation
		isHidden

	measure 'H7 citations' =
			VAR vN = [Livrables mesurés]
			VAR vReste = [Citations sans source après approbation]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, "Non mesuré", IF(vN = 0, "Non mesuré", vReste & " sur " & FORMAT([Citations approuvées], "#,0", "fr-FR") & " citations (" & vN & IF(vN > 1, " livrables", " livrable") & ") · cible 0 · "
			    & IF(vReste > 0, "non atteint",
			        IF(vN < [Livrables approuvés], "non mesuré en totalité",
			            IF(vN < 30, "effectif insuffisant pour conclure", "atteint")))))
		displayFolder: 9. Présentation
		isHidden

	measure 'H7 retouche' =
			VAR vN = [Sections rédigées puis approuvées]
			VAR vTaux = [Sections acceptées sans retouche]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, "Non mesuré", IF(vN < 30, "Effectif insuffisant (n = " & vN & ")",
			    FORMAT(vTaux, "0 %") & " (" & [Nombre de sections sans retouche] & " sur " & vN & ") · cible ≥ 50 % · "
			    & IF(vTaux >= 0.5, "atteint", "non atteint") & ", approximation par section"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport file' = [Livrables à valider] & IF([Livrables à valider] > 1, " livrables", " livrable") & ", dont " & [Relectures en retard] & " en retard"
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport délai' =
			VAR v = [Délai de validation]
			RETURN IF(ISBLANK(v), [Note Délai de validation],
			    FORMAT(v, "0") & " h (" & [Note Délai de validation] & ")")
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport renvois' =
			VAR v = [Renvois à la première relecture]
			RETURN IF(ISBLANK(v), [Note Renvois à la première relecture],
			    FORMAT(v, "0 %") & " (" & [Note Renvois à la première relecture] & ")")
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport bloquantes' = [Phrases bloquantes à vérifier] & " en relecture, " & [Phrases bloquantes à corriger] & " chez les consultants"
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport vérifiées' =
			VAR vN = [Phrases générées]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, "Non mesuré", IF(vN < 30, "Effectif insuffisant",
			    FORMAT([Phrases vérifiées], "0 %") & " de " & FORMAT(vN, "#,0", "fr-FR") & " phrases générées"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Rapport détectées' =
			VAR vN = [Citations générées]
			RETURN IF(MAX('Source des données'[Est une démonstration]) = 1, "Non mesuré", IF(vN < 30, "Effectif insuffisant",
			    FORMAT([Citations sans source avant relecture], "0 %") & " ("
			    & [Nombre de citations sans source avant relecture] & " sur " & FORMAT(vN, "#,0", "fr-FR") & ")"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc décision' =
			VAR vRetenues = FILTER(ALL(Banc), Banc[Code de décision] = "retain")
			VAR vMesurees = COUNTROWS(FILTER(ALL(Banc), NOT ISBLANK(Banc[TPV]))) + 0
			VAR vNombre = COUNTROWS(vRetenues) + 0
			RETURN IF(vMesurees = 0, "Banc d'essai non mesuré",
			    IF(vNombre = 0, "Rester sur B",
			        "À retenir : " & CONCATENATEX(vRetenues, Banc[Configuration], ", ")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc montage' = SELECTEDVALUE(Banc[Montage])
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc effectif' = IF(COUNTROWS(Banc) = 1, COALESCE(FORMAT(MAX(Banc[Sections du banc]), "0"), "—"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc TPV' = IF(COUNTROWS(Banc) = 1, IF(ISBLANK(MAX(Banc[TPV])), "Non mesuré", FORMAT(MAX(Banc[TPV]), "0 %")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc écart' =
			IF(COUNTROWS(Banc) = 1, IF(ISBLANK(MAX(Banc[Écart])), "—",
			    FORMAT(100 * MAX(Banc[Écart]), "+0.0;-0.0;0.0", "fr-FR")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc latence' =
			IF(COUNTROWS(Banc) = 1, IF(ISBLANK(MAX(Banc[Latence p95])), "—",
			    FORMAT(MAX(Banc[Latence p95]) / 1000, "0") & " s"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Banc verdict' = SELECTEDVALUE(Banc[Décision])
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de décision' = SWITCH(SELECTEDVALUE(Banc[Code de décision]), "worse", "#B4232F", "unsafe", "#B4232F", "#2E2E38")
		displayFolder: 9. Présentation
		isHidden

	measure 'Format taux' =
			VAR vN = [Documents analysés]
			VAR vSignales = [Nombre de documents signalés]
			RETURN IF(vN > 0, IF(vN < 30, "Effectif faible", FORMAT(DIVIDE(vSignales, vN), "0 %")))
		displayFolder: 9. Présentation
		isHidden

	measure 'Mission signalée' =
			VAR v = SUM(Documents[Alertes])
			RETURN IF(v > 0, v)
		displayFolder: 9. Présentation
		isHidden

	measure 'Mission documents' = IF(NOT ISBLANK([Mission signalée]), COUNTROWS(Documents))
		displayFolder: 9. Présentation
		isHidden

	column Colonne
		dataType: string
		isHidden
		sourceColumn: Colonne
		summarizeBy: none

	partition Indicateurs = m
		mode: import
		source =
				let
				    Vide = #table(type table [Colonne = text], {})
				in
				    Vide
