table Indicateurs

	/// Projets (dossiers) dans le périmètre des filtres.
	measure Projets = COUNTROWS(Projets) + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Projets de démonstration' = CALCULATE(COUNTROWS(Projets), Projets[Données] = "Démonstration") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Projets réels' = CALCULATE(COUNTROWS(Projets), Projets[Données] = "Réelles") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure Documents = SUM(Projets[Documents]) + 0
		formatString: #,0
		displayFolder: 1. Activité

	/// Livrables créés dans la période.
	measure Livrables = COUNTROWS(Livrables)
		formatString: #,0
		displayFolder: 1. Activité

	measure Brouillons = CALCULATE(COUNTROWS(Livrables), Livrables[Code d'état] = "draft") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure 'En relecture' = CALCULATE(COUNTROWS(Livrables), Livrables[Code d'état] = "in_review") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Approuvés' = CALCULATE(COUNTROWS(Livrables), Livrables[Code d'état] = "approved") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Renvoyés' = CALCULATE(COUNTROWS(Livrables), Livrables[Code d'état] = "rejected") + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure Constats = COUNTROWS(Constats)
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Constats à valider' = CALCULATE(COUNTROWS(Constats), Constats[Validé] = 0) + 0
		formatString: #,0
		displayFolder: 1. Activité

	measure Initiatives = COUNTROWS(Initiatives)
		formatString: #,0
		displayFolder: 1. Activité

	measure 'Constats traités' = SUM(Initiatives[Constats traités])
		formatString: #,0
		displayFolder: 1. Activité

	/// Chaque appel : une section, une extraction de constats, un regroupement en axes, des initiatives.
	measure 'Appels au modèle' = COUNTROWS('Générations')
		formatString: #,0
		displayFolder: 1. Activité

	/// Durée moyenne d'un appel au modèle, en secondes, sur le PC local.
	measure 'Temps moyen par appel' = DIVIDE(AVERAGE('Générations'[Durée en ms]), 1000)
		formatString: 0.0 "s"
		displayFolder: 1. Activité

	measure 'Appels en erreur' = SUM('Générations'[En erreur]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	/// Part des appels avec au moins une erreur : refus, sortie invalide, phrase non vérifiée ou citation sans source. Un refus peut être la bonne réponse : il est compté pour être regardé.
	measure 'Taux d''erreur de l''IA' = DIVIDE([Appels en erreur], [Appels au modèle])
		formatString: 0 %
		displayFolder: 2. Qualité de l'IA

	measure 'Phrases générées' = SUM('Générations'[Phrases produites]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Phrases vérifiées' = SUM('Générations'[Phrases validées]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	/// Phrases retrouvées dans leur source par le vérificateur ÷ phrases générées.
	measure 'Taux de phrases vérifiées' = DIVIDE([Phrases vérifiées], [Phrases générées])
		formatString: 0 %
		displayFolder: 2. Qualité de l'IA

	measure 'Phrases non vérifiées' = SUM('Générations'[Phrases non vérifiées]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Taux de phrases non vérifiées' = DIVIDE([Phrases non vérifiées], [Phrases générées])
		formatString: 0.0 %
		displayFolder: 2. Qualité de l'IA

	measure 'Phrases à revoir' = SUM('Générations'[Phrases à revoir]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Citations générées' = SUM('Générations'[Citations produites]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Citations sans source' = SUM('Générations'[Citations produites]) - SUM('Générations'[Citations valides]) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Taux de citations sans source' = DIVIDE([Citations sans source], [Citations générées])
		formatString: 0.0 %
		displayFolder: 2. Qualité de l'IA

	measure 'Sections générées' = COUNTROWS(FILTER('Générations', NOT 'Générations'[Code de section] IN {"_findings", "_axes", "_initiatives"})) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Sections refusées' = CALCULATE(COUNTROWS('Générations'), 'Générations'[Statut] = "refused") + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	/// Sections où le modèle répond « preuves insuffisantes » ÷ sections demandées.
	measure 'Taux de refus' = DIVIDE([Sections refusées], [Sections générées])
		formatString: 0 %
		displayFolder: 2. Qualité de l'IA

	measure 'Sorties invalides' = CALCULATE(COUNTROWS('Générations'), 'Générations'[Statut] = "invalid") + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Appels feuille de route' = CALCULATE(COUNTROWS('Générations'), 'Générations'[Code de section] IN {"_axes", "_initiatives"}) + 0
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	/// Erreurs du type choisi (table Types d'erreur).
	measure Erreurs = SWITCH(SELECTEDVALUE('Types d''erreur'[Code d'erreur]), "failed", [Phrases non vérifiées], "warning", [Phrases à revoir], "citation", [Citations sans source], "refused", [Sections refusées], "invalid", [Sorties invalides])
		formatString: #,0
		displayFolder: 2. Qualité de l'IA

	measure 'Rapports d''audit' = COUNTROWS(Rapports) + 0
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	/// Numéros « Recommandation n° … » que le rapport annonce (plus grand numéro cité).
	measure 'Recommandations annoncées' = SUM(Rapports[Annoncées]) + 0
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	/// Version corrigée par le consultant : supprimées et fusionnées exclues.
	measure 'Recommandations retenues' = CALCULATE(COUNTROWS(Recommandations), Recommandations[Active] = 1)
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	measure 'Recommandations validées' = CALCULATE(COUNTROWS(Recommandations), Recommandations[Code du statut] = "validated")
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	measure 'Recommandations à valider' = CALCULATE(COUNTROWS(Recommandations), Recommandations[Code du statut] = "proposed")
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	/// Numéros annoncés par le rapport mais absents des recommandations retenues.
	measure 'Recommandations manquantes' = SUM(Rapports[Manquantes])
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	/// Rapports avec un écart de numérotation (trou, doublon) ou sans aucune recommandation détectée.
	measure 'Rapports en alerte' = SUM(Rapports[En alerte]) + 0
		formatString: #,0
		displayFolder: 3. Recommandations des rapports

	measure 'Entraînements' = COUNTROWS('Entraînements') + 0
		formatString: #,0
		displayFolder: 4. Entraînement

	measure 'Entraînements adoptés' = CALCULATE(COUNTROWS('Entraînements'), 'Entraînements'[Adopté] = 1) + 0
		formatString: #,0
		displayFolder: 4. Entraînement

	measure 'Modèle adopté' = CALCULATE(SELECTEDVALUE('Entraînements'[Essai], "Aucun"), REMOVEFILTERS('Entraînements'), 'Entraînements'[Adopté] = 1)
		displayFolder: 4. Entraînement

	measure 'Meilleure erreur du modèle adopté' = CALCULATE(MIN('Entraînements'[Meilleure erreur de validation]), REMOVEFILTERS('Entraînements'), 'Entraînements'[Adopté] = 1)
		formatString: 0.000
		displayFolder: 4. Entraînement

	measure 'Exemples d''entraînement' = MAX('Entraînements'[Exemples d'entraînement])
		formatString: #,0
		displayFolder: 4. Entraînement

	/// Erreur sur les exemples mis de côté, mesurée tous les 20 pas : elle doit baisser.
	measure 'Erreur de validation' = AVERAGE('Courbe de validation'[Erreur de validation])
		formatString: 0.000
		displayFolder: 4. Entraînement

	measure 'Erreur au meilleur pas' = CALCULATE([Erreur de validation], 'Courbe de validation'[Meilleur] = 1)
		formatString: 0.000
		displayFolder: 4. Entraînement

	measure 'Exemples réussis' = SUM(Scores[Réussis]) + 0
		formatString: #,0
		displayFolder: 4. Entraînement

	measure 'Exemples testés' = SUM(Scores[Total]) + 0
		formatString: #,0
		displayFolder: 4. Entraînement

	/// Exemples de test réussis ÷ exemples de test, par tâche et par modèle.
	measure 'Taux de réussite' = DIVIDE(SUM(Scores[Réussis]), SUM(Scores[Total]))
		formatString: 0 %
		displayFolder: 4. Entraînement

	measure 'Mention données' =
			VAR d = [Projets de démonstration]
			VAR r = [Projets réels]
			RETURN IF(d = 0, "Données réelles", IF(r = 0, "[DÉMO] projets de démonstration", "[DÉMO] " & r & " projet(s) réel(s) + " & d & " de démonstration"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Badge démo' = IF([Projets de démonstration] > 0, "[DÉMO] inclut des données de démonstration", "Données réelles")
		displayFolder: 9. Présentation
		isHidden

	measure 'Section la moins vérifiée' =
			VAR s = FILTER(ADDCOLUMNS(VALUES('Sections'[Section]), "t", DIVIDE([Phrases non vérifiées], [Phrases générées]), "n", [Phrases générées]), [n] >= 10)
			VAR p = TOPN(1, s, [t], DESC)
			RETURN MAXX(p, 'Sections'[Section])
		displayFolder: 9. Présentation
		isHidden

	measure 'Section la plus refusée' =
			VAR s = FILTER(ADDCOLUMNS(VALUES('Sections'[Section]), "t", DIVIDE([Sections refusées], [Sections générées]), "n", [Sections générées]), [n] >= 3)
			VAR p = TOPN(1, s, [t], DESC)
			RETURN MAXX(p, 'Sections'[Section])
		displayFolder: 9. Présentation
		isHidden

	measure 'Actions déclenchées' =
			VAR t = FILTER({
			    (1, IF([Rapports en alerte] > 0, "Contrôler " & [Rapports en alerte] & " rapport(s) d'audit : " & [Recommandations manquantes] + 0 & " recommandation(s) manquante(s) ou non détectée(s). Page Recommandations du dossier." & "  [" & "Consultant" & "]", BLANK())),
			    (2, IF(DIVIDE([Sorties invalides], [Appels feuille de route]) >= 0.1, "Relancer la feuille de route : " & [Sorties invalides] & " réponse(s) du modèle au mauvais format sur " & [Appels feuille de route] & " appels." & "  [" & "Consultant" & "]", BLANK())),
			    (3, IF([Taux de phrases non vérifiées] >= 0.1, "Revoir les sources de « " & [Section la moins vérifiée] & " » : " & FORMAT([Taux de phrases non vérifiées], "0 %") & " des phrases non vérifiées sur le périmètre." & "  [" & "Consultant" & "]", BLANK())),
			    (4, IF([Taux de refus] >= 0.2, "Compléter les documents : le modèle refuse " & FORMAT([Taux de refus], "0 %") & " des sections faute de preuves, surtout « " & [Section la plus refusée] & " »." & "  [" & "Consultant" & "]", BLANK())),
			    (5, IF([En relecture] > 0, "Relire " & [En relecture] & " livrable(s) en attente de validation." & "  [" & "Responsable" & "]", BLANK())),
			    (6, IF([Renvoyés] > 0, "Reprendre " & [Renvoyés] & " livrable(s) renvoyé(s) par le responsable." & "  [" & "Consultant" & "]", BLANK())),
			    (7, IF([Constats à valider] > 0, "Valider " & [Constats à valider] & " constat(s) avant de produire la feuille de route." & "  [" & "Consultant" & "]", BLANK()))
			}, NOT ISBLANK([Value2]))
			RETURN COUNTROWS(t) + 0
		displayFolder: 9. Présentation
		isHidden

	measure 'Liste des actions' =
			VAR t = FILTER({
			    (1, IF([Rapports en alerte] > 0, "Contrôler " & [Rapports en alerte] & " rapport(s) d'audit : " & [Recommandations manquantes] + 0 & " recommandation(s) manquante(s) ou non détectée(s). Page Recommandations du dossier." & "  [" & "Consultant" & "]", BLANK())),
			    (2, IF(DIVIDE([Sorties invalides], [Appels feuille de route]) >= 0.1, "Relancer la feuille de route : " & [Sorties invalides] & " réponse(s) du modèle au mauvais format sur " & [Appels feuille de route] & " appels." & "  [" & "Consultant" & "]", BLANK())),
			    (3, IF([Taux de phrases non vérifiées] >= 0.1, "Revoir les sources de « " & [Section la moins vérifiée] & " » : " & FORMAT([Taux de phrases non vérifiées], "0 %") & " des phrases non vérifiées sur le périmètre." & "  [" & "Consultant" & "]", BLANK())),
			    (4, IF([Taux de refus] >= 0.2, "Compléter les documents : le modèle refuse " & FORMAT([Taux de refus], "0 %") & " des sections faute de preuves, surtout « " & [Section la plus refusée] & " »." & "  [" & "Consultant" & "]", BLANK())),
			    (5, IF([En relecture] > 0, "Relire " & [En relecture] & " livrable(s) en attente de validation." & "  [" & "Responsable" & "]", BLANK())),
			    (6, IF([Renvoyés] > 0, "Reprendre " & [Renvoyés] & " livrable(s) renvoyé(s) par le responsable." & "  [" & "Consultant" & "]", BLANK())),
			    (7, IF([Constats à valider] > 0, "Valider " & [Constats à valider] & " constat(s) avant de produire la feuille de route." & "  [" & "Consultant" & "]", BLANK()))
			}, NOT ISBLANK([Value2]))
			RETURN IF(COUNTROWS(t) = 0, "Rien d'urgent : aucune règle ne se déclenche sur ce périmètre.", CONCATENATEX(t, [Value2], " / ", [Value1], ASC))
		displayFolder: 9. Présentation
		isHidden

	measure 'Action 1' =
			VAR t = FILTER({
			    (1, IF([Rapports en alerte] > 0, "Contrôler " & [Rapports en alerte] & " rapport(s) d'audit : " & [Recommandations manquantes] + 0 & " recommandation(s) manquante(s) ou non détectée(s). Page Recommandations du dossier." & "  [" & "Consultant" & "]", BLANK())),
			    (2, IF(DIVIDE([Sorties invalides], [Appels feuille de route]) >= 0.1, "Relancer la feuille de route : " & [Sorties invalides] & " réponse(s) du modèle au mauvais format sur " & [Appels feuille de route] & " appels." & "  [" & "Consultant" & "]", BLANK())),
			    (3, IF([Taux de phrases non vérifiées] >= 0.1, "Revoir les sources de « " & [Section la moins vérifiée] & " » : " & FORMAT([Taux de phrases non vérifiées], "0 %") & " des phrases non vérifiées sur le périmètre." & "  [" & "Consultant" & "]", BLANK())),
			    (4, IF([Taux de refus] >= 0.2, "Compléter les documents : le modèle refuse " & FORMAT([Taux de refus], "0 %") & " des sections faute de preuves, surtout « " & [Section la plus refusée] & " »." & "  [" & "Consultant" & "]", BLANK())),
			    (5, IF([En relecture] > 0, "Relire " & [En relecture] & " livrable(s) en attente de validation." & "  [" & "Responsable" & "]", BLANK())),
			    (6, IF([Renvoyés] > 0, "Reprendre " & [Renvoyés] & " livrable(s) renvoyé(s) par le responsable." & "  [" & "Consultant" & "]", BLANK())),
			    (7, IF([Constats à valider] > 0, "Valider " & [Constats à valider] & " constat(s) avant de produire la feuille de route." & "  [" & "Consultant" & "]", BLANK()))
			}, NOT ISBLANK([Value2]))
			VAR r = IF(COUNTROWS(t) >= 1, MAXX(TOPN(1, t, [Value1], ASC), [Value1]))
			RETURN IF(ISBLANK(r), "Rien d'urgent : aucune règle ne se déclenche sur ce périmètre.", MAXX(FILTER(t, [Value1] = r), [Value2]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Numéro action 1' = IF([Actions déclenchées] >= 1, "1", "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Action 2' =
			VAR t = FILTER({
			    (1, IF([Rapports en alerte] > 0, "Contrôler " & [Rapports en alerte] & " rapport(s) d'audit : " & [Recommandations manquantes] + 0 & " recommandation(s) manquante(s) ou non détectée(s). Page Recommandations du dossier." & "  [" & "Consultant" & "]", BLANK())),
			    (2, IF(DIVIDE([Sorties invalides], [Appels feuille de route]) >= 0.1, "Relancer la feuille de route : " & [Sorties invalides] & " réponse(s) du modèle au mauvais format sur " & [Appels feuille de route] & " appels." & "  [" & "Consultant" & "]", BLANK())),
			    (3, IF([Taux de phrases non vérifiées] >= 0.1, "Revoir les sources de « " & [Section la moins vérifiée] & " » : " & FORMAT([Taux de phrases non vérifiées], "0 %") & " des phrases non vérifiées sur le périmètre." & "  [" & "Consultant" & "]", BLANK())),
			    (4, IF([Taux de refus] >= 0.2, "Compléter les documents : le modèle refuse " & FORMAT([Taux de refus], "0 %") & " des sections faute de preuves, surtout « " & [Section la plus refusée] & " »." & "  [" & "Consultant" & "]", BLANK())),
			    (5, IF([En relecture] > 0, "Relire " & [En relecture] & " livrable(s) en attente de validation." & "  [" & "Responsable" & "]", BLANK())),
			    (6, IF([Renvoyés] > 0, "Reprendre " & [Renvoyés] & " livrable(s) renvoyé(s) par le responsable." & "  [" & "Consultant" & "]", BLANK())),
			    (7, IF([Constats à valider] > 0, "Valider " & [Constats à valider] & " constat(s) avant de produire la feuille de route." & "  [" & "Consultant" & "]", BLANK()))
			}, NOT ISBLANK([Value2]))
			VAR r = IF(COUNTROWS(t) >= 2, MAXX(TOPN(2, t, [Value1], ASC), [Value1]))
			RETURN IF(ISBLANK(r), "", MAXX(FILTER(t, [Value1] = r), [Value2]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Numéro action 2' = IF([Actions déclenchées] >= 2, "2", "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Action 3' =
			VAR t = FILTER({
			    (1, IF([Rapports en alerte] > 0, "Contrôler " & [Rapports en alerte] & " rapport(s) d'audit : " & [Recommandations manquantes] + 0 & " recommandation(s) manquante(s) ou non détectée(s). Page Recommandations du dossier." & "  [" & "Consultant" & "]", BLANK())),
			    (2, IF(DIVIDE([Sorties invalides], [Appels feuille de route]) >= 0.1, "Relancer la feuille de route : " & [Sorties invalides] & " réponse(s) du modèle au mauvais format sur " & [Appels feuille de route] & " appels." & "  [" & "Consultant" & "]", BLANK())),
			    (3, IF([Taux de phrases non vérifiées] >= 0.1, "Revoir les sources de « " & [Section la moins vérifiée] & " » : " & FORMAT([Taux de phrases non vérifiées], "0 %") & " des phrases non vérifiées sur le périmètre." & "  [" & "Consultant" & "]", BLANK())),
			    (4, IF([Taux de refus] >= 0.2, "Compléter les documents : le modèle refuse " & FORMAT([Taux de refus], "0 %") & " des sections faute de preuves, surtout « " & [Section la plus refusée] & " »." & "  [" & "Consultant" & "]", BLANK())),
			    (5, IF([En relecture] > 0, "Relire " & [En relecture] & " livrable(s) en attente de validation." & "  [" & "Responsable" & "]", BLANK())),
			    (6, IF([Renvoyés] > 0, "Reprendre " & [Renvoyés] & " livrable(s) renvoyé(s) par le responsable." & "  [" & "Consultant" & "]", BLANK())),
			    (7, IF([Constats à valider] > 0, "Valider " & [Constats à valider] & " constat(s) avant de produire la feuille de route." & "  [" & "Consultant" & "]", BLANK()))
			}, NOT ISBLANK([Value2]))
			VAR r = IF(COUNTROWS(t) >= 3, MAXX(TOPN(3, t, [Value1], ASC), [Value1]))
			RETURN IF(ISBLANK(r), "", MAXX(FILTER(t, [Value1] = r), [Value2]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Numéro action 3' = IF([Actions déclenchées] >= 3, "3", "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Période' =
			VAR d = MIN(Calendrier[Date])
			VAR f = MAX(Calendrier[Date])
			RETURN "Du " & FORMAT(d, "dd/MM/yyyy") & " au " & FORMAT(f, "dd/MM/yyyy")
		displayFolder: 9. Présentation
		isHidden

	measure 'Périmètre' =
			VAR p = IF(HASONEVALUE(Projets[Projet]), SELECTEDVALUE(Projets[Projet]), [Projets] & " projets")
			VAR c = IF(HASONEVALUE(Projets[Client]), " · " & SELECTEDVALUE(Projets[Client]), "")
			VAR k = IF(ISFILTERED(Personnes[Consultant]) && HASONEVALUE(Personnes[Consultant]), " · " & SELECTEDVALUE(Personnes[Consultant]), "")
			VAR t = IF(ISFILTERED('Types de livrable'[Type de livrable]) && HASONEVALUE('Types de livrable'[Type de livrable]), " · " & SELECTEDVALUE('Types de livrable'[Type de livrable]), "")
			RETURN [Période] & " · " & p & c & k & t
		displayFolder: 9. Présentation
		isHidden

	measure 'Pied de page' = "Traitement local · données au " & FORMAT(CALCULATE(MAXX('Générations', RELATED(Calendrier[Date])), REMOVEFILTERS()), "dd/MM/yyyy")
		displayFolder: 9. Présentation
		isHidden

	measure 'Titre du projet' = IF(HASONEVALUE(Projets[Projet]), SELECTEDVALUE(Projets[Projet]), "Choisissez un projet dans le filtre Projet")
		displayFolder: 9. Présentation
		isHidden

	measure 'Client du projet' = IF(HASONEVALUE(Projets[Projet]), SELECTEDVALUE(Projets[Client]) & IF(SELECTEDVALUE(Projets[Secteur]) <> "", " · " & SELECTEDVALUE(Projets[Secteur]), ""), [Projets] & " projets dans le périmètre")
		displayFolder: 9. Présentation
		isHidden

	measure 'Demande du projet' =
			IF(HASONEVALUE(Projets[Projet]), VAR d = SELECTEDVALUE(Projets[Demande du client])
			RETURN IF(d = "", "Demande du client non renseignée (fiche projet de l'application)", "Demande : " & d), "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Dates du projet' =
			IF(HASONEVALUE(Projets[Projet]), VAR d = SELECTEDVALUE(Projets[Début])
			VAR f = SELECTEDVALUE(Projets[Fin])
			RETURN IF(ISBLANK(d), "Dates non renseignées", "Début " & FORMAT(d, "dd/MM/yyyy") & IF(ISBLANK(f), " · fin non fixée", " · fin " & FORMAT(f, "dd/MM/yyyy"))), "")
		displayFolder: 9. Présentation
		isHidden

	measure 'Recommandations sur annoncées' = [Recommandations retenues] + 0 & " retenues sur " & [Recommandations annoncées] & " annoncées"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note projets' = IF([Projets de démonstration] > 0, "dont " & [Projets de démonstration] & " [DÉMO]", "réels")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note livrables' = [En relecture] & " en relecture · " & [Renvoyés] & " renvoyé(s)"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note erreur' = [Appels en erreur] & " appels sur " & [Appels au modèle] + 0
		displayFolder: 9. Présentation
		isHidden

	measure 'Note temps' = "par appel au modèle, PC local"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note entraînements' = "dont " & [Entraînements adoptés] & " adopté : " & [Modèle adopté]
		displayFolder: 9. Présentation
		isHidden

	measure 'Note vérifiées' = [Phrases vérifiées] & " sur " & [Phrases générées]
		displayFolder: 9. Présentation
		isHidden

	measure 'Note citations' = [Citations sans source] & " sur " & [Citations générées]
		displayFolder: 9. Présentation
		isHidden

	measure 'Note refus' = [Sections refusées] & " sur " & [Sections générées] & " sections"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note invalides' = "sur " & [Appels feuille de route] & " appels de feuille de route"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note recommandations' = [Recommandations validées] + 0 & " validées · " & [Recommandations à valider] + 0 & " à valider"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note rapports' = [Rapports en alerte] & " en alerte"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note constats' = [Constats à valider] & " à valider"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note documents' = [Rapports d'audit] & " rapport(s) d'audit"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note modèle adopté' = "meilleure erreur " & FORMAT([Meilleure erreur du modèle adopté], "0.000")
		displayFolder: 9. Présentation
		isHidden

	measure 'Note exemples' = "au plus, par entraînement"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note essais' = "Colab et Kaggle, GPU T4 gratuit"
		displayFolder: 9. Présentation
		isHidden

	measure 'Note erreur adoptée' = "au meilleur pas (pas d'arrêt anticipé)"
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai date' = FORMAT(SELECTEDVALUE('Entraînements'[Date de l'essai]), "dd/MM/yyyy")
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai plateforme' = SELECTEDVALUE('Entraînements'[Plateforme]) & " · " & SELECTEDVALUE('Entraînements'[GPU])
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai exemples' = FORMAT(SELECTEDVALUE('Entraînements'[Exemples d'entraînement]), "#,0")
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai durée' =
			VAR d = SELECTEDVALUE('Entraînements'[Durée en minutes])
			RETURN IF(ISBLANK(d), "non consignée", FORMAT(d, "0") & " min")
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai meilleure erreur' =
			VAR v = SELECTEDVALUE('Entraînements'[Meilleure erreur de validation])
			VAR p = SELECTEDVALUE('Entraînements'[Meilleur pas])
			RETURN FORMAT(v, "0.000") & IF(ISBLANK(p), " (dernière mesure)", " au pas " & p)
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai arrêt' = "pas " & SELECTEDVALUE('Entraînements'[Pas d'arrêt])
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai décision' = IF(SELECTEDVALUE('Entraînements'[Adopté]) = 1, "Adopté", "Non adopté")
		displayFolder: 9. Présentation
		isHidden

	measure 'Essai résultat' = SELECTEDVALUE('Entraînements'[Résultat de l'essai])
		displayFolder: 9. Présentation
		isHidden

	measure 'Alerte projet' = IF(SUM(Rapports[En alerte]) > 0, SELECTEDVALUE(Rapports[Projet du rapport]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Alerte annoncées' = IF(SUM(Rapports[En alerte]) > 0, FORMAT(SUM(Rapports[Annoncées]), "0"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Alerte retenues' = IF(SUM(Rapports[En alerte]) > 0, FORMAT(SUM(Rapports[Retenues]), "0"))
		displayFolder: 9. Présentation
		isHidden

	measure 'Alerte manquants' =
			IF(SUM(Rapports[En alerte]) > 0, VAR l = SELECTEDVALUE(Rapports[Numéros manquants])
			RETURN IF(l = "", "—", "n° " & l))
		displayFolder: 9. Présentation
		isHidden

	measure 'Alerte contrôle' = IF(SUM(Rapports[En alerte]) > 0, SELECTEDVALUE(Rapports[Contrôle]))
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de l''alerte' = IF(SUM(Rapports[En alerte]) > 0, "#B4232F")
		displayFolder: 9. Présentation
		isHidden

	measure 'Couleur de vague' =
			VAR n = [Initiatives]
			RETURN SWITCH(TRUE(), n >= 4, "#FFE600", n >= 2, "#FFEE66", n >= 1, "#FFF7B3", "#FFFFFF")
		displayFolder: 9. Présentation
		isHidden

	measure 'Initiatives de la case' = IF([Initiatives] > 0, [Initiatives])
		displayFolder: 9. Présentation
		isHidden

	measure 'ST synthese par_mois' = "Selon le résultat · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST synthese etats' = "Créés dans la période · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST synthese par_projet' = "Clic droit sur un projet pour filtrer · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST projet recos_rapport' = "En rouge : numéros annoncés mais absents · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST projet constats_axe' = "Axe : celui de l'initiative qui traite le constat · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST projet feuille' = "Vague 1 d'abord · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST projet avancement' = "Part de chaque état, par type · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST projet sections' = "Phrases vérifiées ; survol : à quoi sert la section · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST qualite tendance' = "Part des appels, des phrases et des sections · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST qualite types' = "Survol : ce que signifie chaque type · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST qualite alertes' = "Rapports à vérifier par le consultant, les plus graves d'abord · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST qualite modeles' = "Modèle utilisé par l'application · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST impression par_mois' = "Selon le résultat · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST impression etats' = "Créés dans la période · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST impression par_projet' = "Clic droit sur un projet pour filtrer · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	measure 'ST impression recos_rapport' = "En rouge : numéros annoncés mais absents · " & [Mention données]
		displayFolder: 9. Présentation
		isHidden

	column Colonne
		dataType: string
		isHidden
		sourceColumn: Colonne
		summarizeBy: none

	partition Indicateurs = m
		mode: import
		source =
				let
				    Vide = #table(type table [Colonne = text], {})
				in
				    Vide
