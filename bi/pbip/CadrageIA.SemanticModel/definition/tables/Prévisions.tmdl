table 'Prévisions'
	isHidden

	column 'Clé de prévision'
		dataType: int64
		isHidden
		sourceColumn: forecast_key
		summarizeBy: none

	column 'Client prévu'
		dataType: string
		isHidden
		sourceColumn: client_name
		summarizeBy: none

	column 'Clé de type prévu'
		dataType: int64
		isHidden
		sourceColumn: type_key
		summarizeBy: none

	column 'Clé de personne prévue'
		dataType: int64
		isHidden
		sourceColumn: author_key
		summarizeBy: none

	column 'Clé de responsable prévu'
		dataType: int64
		isHidden
		sourceColumn: reviewer_key
		summarizeBy: none

	column 'Rang de périmètre'
		dataType: int64
		isHidden
		sourceColumn: rang
		summarizeBy: none

	column 'Statut de prévision'
		dataType: string
		isHidden
		sourceColumn: status
		summarizeBy: none

	column Semaines
		dataType: int64
		isHidden
		sourceColumn: weeks
		summarizeBy: none

	column Soumissions
		dataType: int64
		isHidden
		sourceColumn: events
		summarizeBy: none

	column Origines
		dataType: int64
		isHidden
		sourceColumn: origins
		summarizeBy: none

	column Point
		dataType: double
		isHidden
		sourceColumn: point
		summarizeBy: none

	column Bas
		dataType: double
		isHidden
		sourceColumn: low
		summarizeBy: none

	column Haut
		dataType: double
		isHidden
		sourceColumn: high
		summarizeBy: none

	column Erreur
		dataType: double
		isHidden
		sourceColumn: mae
		summarizeBy: none

	column 'Erreur naïve'
		dataType: double
		isHidden
		sourceColumn: mae_naive
		summarizeBy: none

	column 'Statut du risque'
		dataType: string
		isHidden
		sourceColumn: risk_status
		summarizeBy: none

	column Brier
		dataType: double
		isHidden
		sourceColumn: risk_brier
		summarizeBy: none

	column 'Brier naïf'
		dataType: double
		isHidden
		sourceColumn: risk_brier_naive
		summarizeBy: none

	column 'Cas testés'
		dataType: int64
		isHidden
		sourceColumn: risk_tested
		summarizeBy: none

	column 'Périmètre client'
		dataType: string
		isHidden
		sourceColumn: perimetre_client
		summarizeBy: none

	column 'Périmètre type'
		dataType: string
		isHidden
		sourceColumn: perimetre_type
		summarizeBy: none

	column 'Périmètre consultant'
		dataType: string
		isHidden
		sourceColumn: perimetre_consultant
		summarizeBy: none

	partition 'Prévisions' = m
		mode: import
		source =
				let
				    Brut = Vue("v_forecast"),
				    Choix = Table.SelectColumns(Brut, {"forecast_key", "client_name", "type_key", "author_key", "reviewer_key", "status", "weeks", "events", "origins", "point", "low", "high", "mae", "mae_naive", "risk_status", "risk_brier", "risk_brier_naive", "risk_tested"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"forecast_key", Int64.Type}, {"client_name", type text}, {"type_key", Int64.Type}, {"author_key", Int64.Type}, {"reviewer_key", Int64.Type}, {"status", type text}, {"weeks", Int64.Type}, {"events", Int64.Type}, {"origins", Int64.Type}, {"point", type number}, {"low", type number}, {"high", type number}, {"mae", type number}, {"mae_naive", type number}, {"risk_status", type text}, {"risk_brier", type number}, {"risk_brier_naive", type number}, {"risk_tested", Int64.Type}}, CultureCsv),
				    AvecClient = Table.AddColumn(Typage, "perimetre_client", each if [client_name] = null or [client_name] = "" then "Tous" else [client_name], type text),
				    AvecType = Table.AddColumn(AvecClient, "perimetre_type", each if [type_key] = null then "Tous" else Record.FieldOrDefault([#"1" = "Constats", #"2" = "Feuille de route", #"3" = "Termes de référence", #"4" = "Cahier des charges"], Text.From([type_key]), "Autre"), type text),
				    Gens = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_person"), {"user_key", "user_label"}), {{"user_key", Int64.Type}, {"user_label", type text}}, CultureCsv),
				    Jointure = Table.NestedJoin(AvecType, {"author_key"}, Gens, {"user_key"}, "p", JoinKind.LeftOuter),
				    AvecNom = Table.ExpandTableColumn(Jointure, "p", {"user_label"}),
				    AvecRang = Table.AddColumn(AvecNom, "rang", each (if [author_key] = null then 0 else 1) + (if [reviewer_key] = null then 0 else 2), Int64.Type),
				    AvecPersonne = Table.AddColumn(AvecRang, "perimetre_consultant", each if [author_key] = null then "Tous" else [user_label], type text),
				    Utiles = Table.RemoveColumns(AvecPersonne, {"user_label"})
				in
				    Utiles
