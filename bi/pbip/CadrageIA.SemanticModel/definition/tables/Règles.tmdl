	partition 'Règles' = m
		mode: import
		source =
				let
				    Resultat = #table(type table [#"code" = text, #"priorite" = Int64.Type, #"acteur" = text, #"libelle" = text, #"population" = text, #"seuil" = text, #"action" = text, #"etats" = text], {{"citation_restante", 1, "Responsable", "Approuvés avec une citation sans source", "livrables approuvés", "au moins 1 citation sans source dans la version approuvée (H7 : 0)", "Corriger puis faire réapprouver.", "approved"}, {"relecture_en_retard", 2, "Responsable", "Relectures en retard", "livrables en relecture", "en relecture depuis plus de 48 h", "Relire d'abord le plus ancien.", "in_review"}, {"renvoi_a_reprendre", 3, "Consultant", "Renvois à reprendre", "livrables chez les consultants", "renvoyé par un responsable et pas encore resoumis", "Reprendre selon le motif du renvoi.", "draft|rejected"}, {"bloquant_en_relecture", 4, "Responsable", "Soumis avec une phrase bloquante", "livrables en relecture", "au moins 1 phrase bloquante encore présente", "Vérifier avant d'approuver.", "in_review"}, {"bloquant_avant_soumission", 5, "Consultant", "Brouillons avec une phrase bloquante", "livrables chez les consultants", "au moins 1 phrase bloquante encore présente", "Corriger la source ou le chiffre.", "draft|rejected"}, {"preuve_manquante", 6, "Consultant", "Sections refusées faute de preuve", "livrables chez les consultants", "au moins 1 section refusée dans la version courante", "Ajouter le document manquant.", "draft|rejected"}, {"brouillon_en_sommeil", 7, "Consultant", "Brouillons sans activité", "livrables chez les consultants", "aucune activité depuis plus de 5 jours", "Soumettre ou signaler le blocage.", "draft|rejected"}})
				in
				    Resultat
