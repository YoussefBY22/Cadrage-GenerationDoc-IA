table 'Choix du type'

	column 'Type choisi'
		dataType: string
		sourceColumn: choix
		sortByColumn: Rang
		summarizeBy: none

	column Cible
		dataType: string
		isHidden
		sourceColumn: cible
		summarizeBy: none

	column Rang
		dataType: int64
		isHidden
		sourceColumn: rang
		summarizeBy: none

	partition 'Choix du type' = m
		mode: import
		source =
				let
				    Valeurs = List.Buffer(List.Sort(List.Distinct(List.RemoveNulls(let Presents = List.Buffer(Table.Column(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_deliverable"), {"type_key"}), {{"type_key", Int64.Type}}, CultureCsv), "type_key")) in Table.Column(Table.SelectRows(#table(type table [#"type_key" = Int64.Type, #"type_code" = text, #"libelle" = text], {{1, "findings", "Constats"}, {2, "roadmap", "Feuille de route"}, {3, "tor", "Termes de référence"}, {4, "cdc", "Cahier des charges"}}), each List.Contains(Presents, [type_key])), "libelle"))))),
				    Toutes = List.Transform(Valeurs, each {"Tous", _, 0}),
				    Chacune = List.Transform(Valeurs, each {_, _, List.PositionOf(Valeurs, _) + 1}),
				    Resultat = #table(type table [choix = text, cible = text, rang = Int64.Type], Toutes & Chacune)
				in
				    Resultat
