table 'Modèles'

	column model_key
		dataType: int64
		isHidden
		sourceColumn: model_key
		summarizeBy: none

	column provider
		dataType: string
		sourceColumn: provider
		summarizeBy: none

	column model_name
		dataType: string
		sourceColumn: model_name
		summarizeBy: none

	column config_label
		dataType: string
		sourceColumn: config_label
		summarizeBy: none

	partition 'Modèles' = m
		mode: import
		source =
				let
				    Base = Table.Distinct(Table.SelectColumns(v_generation, {"model_key", "provider", "model_name", "config_label"})),
				    Résultat = Table.Distinct(Base, {"model_key"})
				in
				    Résultat

