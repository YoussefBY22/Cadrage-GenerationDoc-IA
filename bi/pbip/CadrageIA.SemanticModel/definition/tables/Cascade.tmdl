table Cascade
	isHidden

	column 'Résultat du contrôle'
		dataType: string
		sourceColumn: libelle
		sortByColumn: Ordre
		summarizeBy: none

	column Ordre
		dataType: int64
		isHidden
		sourceColumn: ordre
		summarizeBy: none

	partition Cascade = m
		mode: import
		source =
				let
				    Resultat = #table(type table [#"libelle" = text, #"ordre" = Int64.Type], {{"Générées", 1}, {"À vérifier", 2}, {"Rejetées", 3}})
				in
				    Resultat
