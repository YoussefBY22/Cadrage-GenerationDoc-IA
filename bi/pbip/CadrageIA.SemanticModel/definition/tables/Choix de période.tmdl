table 'Choix de période'

	column 'Période choisie'
		dataType: string
		sourceColumn: choix
		sortByColumn: Rang
		summarizeBy: none

	column 'Clé de date cible'
		dataType: int64
		isHidden
		sourceColumn: date_key
		summarizeBy: none

	column Rang
		dataType: int64
		isHidden
		sourceColumn: rang
		summarizeBy: none

	partition 'Choix de période' = m
		mode: import
		source =
				let
				    Cles = List.Buffer(List.RemoveNulls(List.Combine({Table.Column(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_generation"), {"date_key"}), {{"date_key", Int64.Type}}, CultureCsv), "date_key"), Table.Column(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_deliverable"), {"approved_date_key"}), {{"approved_date_key", Int64.Type}}, CultureCsv), "approved_date_key"), Table.Column(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_deliverable"), {"submitted_date_key"}), {{"submitted_date_key", Int64.Type}}, CultureCsv), "submitted_date_key")}))),
				    VersDate = (k as number) as date => #date(Number.IntegerDivide(k, 10000), Number.Mod(Number.IntegerDivide(k, 100), 100), Number.Mod(k, 100)),
				    Premier = VersDate(List.Min(Cles, 20260101)),
				    Dernier = VersDate(List.Max(Cles, 20261231)),
				    Jours = List.Dates(Date.StartOfMonth(Premier), Duration.Days(Date.EndOfMonth(Dernier) - Date.StartOfMonth(Premier)) + 1, #duration(1, 0, 0, 0)),
				    Cle = (d as date) as number => Date.Year(d) * 10000 + Date.Month(d) * 100 + Date.Day(d),
				    Historique = List.Transform(Jours, each {"Tout l'historique", Cle(_), 0}),
				    Recentes4 = List.Transform(List.Select(Jours, each _ > Date.AddDays(Dernier, -28) and _ <= Dernier), each {"4 dernières semaines", Cle(_), 1}),
				    Recentes13 = List.Transform(List.Select(Jours, each _ > Date.AddDays(Dernier, -91) and _ <= Dernier), each {"13 dernières semaines", Cle(_), 2}),
				    ParMois = List.Transform(Jours, each {{"Janvier", "Février", "Mars", "Avril", "Mai", "Juin", "Juillet", "Août", "Septembre", "Octobre", "Novembre", "Décembre"}{Date.Month(_) - 1} & " " & Text.From(Date.Year(_)), Cle(_), 300000 - (Date.Year(_) * 100 + Date.Month(_))}),
				    Resultat = #table(type table [choix = text, date_key = Int64.Type, rang = Int64.Type], Historique & Recentes4 & Recentes13 & ParMois)
				in
				    Resultat
