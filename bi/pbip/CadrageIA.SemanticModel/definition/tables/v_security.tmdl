table v_security

	column mission_key
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column mission_name
		dataType: string
		sourceColumn: mission_name
		summarizeBy: none

	column document_key
		dataType: int64
		isHidden
		sourceColumn: document_key
		summarizeBy: none

	column document_id
		dataType: string
		sourceColumn: document_id
		summarizeBy: none

	column mime
		dataType: string
		sourceColumn: mime
		summarizeBy: none

	column injection_alert_count
		dataType: int64
		sourceColumn: injection_alert_count
		summarizeBy: none

	column is_demo
		dataType: int64
		sourceColumn: is_demo
		summarizeBy: none

	partition v_security = m
		mode: import
		source =
				let
				    Brut = Vue("v_security"),
				    Typé = Table.TransformColumnTypes(Brut, {{"mission_key", Int64.Type}, {"mission_name", type text}, {"document_key", Int64.Type}, {"document_id", type text}, {"mime", type text}, {"injection_alert_count", Int64.Type}, {"is_demo", Int64.Type}}, CultureCsv)
				in
				    Typé

