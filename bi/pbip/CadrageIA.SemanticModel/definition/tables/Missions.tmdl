table Missions

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column Mission
		dataType: string
		sourceColumn: mission_name
		summarizeBy: none

	column Client
		dataType: string
		sourceColumn: client_name
		summarizeBy: none

	partition Missions = m
		mode: import
		source =
				let
				    Suivies = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_deliverable"), {"mission_key", "mission_name", "client_name"}), {{"mission_key", Int64.Type}, {"mission_name", type text}, {"client_name", type text}}, CultureCsv),
				    Actives = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_generation"), {"mission_key", "mission_name", "client_name"}), {{"mission_key", Int64.Type}, {"mission_name", type text}, {"client_name", type text}}, CultureCsv),
				    Importees = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_security"), {"mission_key", "mission_name"}), {{"mission_key", Int64.Type}, {"mission_name", type text}}, CultureCsv),
				    SansClient = Table.AddColumn(Importees, "client_name", each "Non renseigné", type text),
				    Resultat = Table.Distinct(Table.Buffer(Table.Combine({Suivies, Actives, SansClient})), {"mission_key"})
				in
				    Resultat
