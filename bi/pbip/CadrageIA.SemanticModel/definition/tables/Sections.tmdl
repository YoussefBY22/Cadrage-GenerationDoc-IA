table Sections

	column 'Clé de section'
		dataType: string
		isHidden
		sourceColumn: cle
		summarizeBy: none

	column Section
		dataType: string
		sourceColumn: libelle
		summarizeBy: none

	column 'À quoi sert la section'
		dataType: string
		sourceColumn: role
		summarizeBy: none

	column 'Livrable de la section'
		dataType: string
		sourceColumn: livrable
		summarizeBy: none

	partition Sections = m
		mode: import
		source =
				let
				    Gabarits = #table(type table [#"cle" = text, #"libelle" = text, #"role" = text, #"livrable" = text], {{"cdc|chg_accompagnement", "Plan d'accompagnement", "Décrit le plan de communication, de formation et d'accompagnement. Module : organisation et conduite du changement.", "CdC"}, {"cdc|chg_mesure", "Mesure de l'adoption", "Décrit les indicateurs d'adoption tels que les décisions confirmées les fixent. Module : organisation et conduite du changement.", "CdC"}, {"cdc|chg_parties", "Parties prenantes et impacts", "Décrit les parties prenantes et les impacts du changement. Module : organisation et conduite du changement.", "CdC"}, {"cdc|contraintes", "Contraintes", "Décrit les contraintes techniques, réglementaires, budgétaires et de délai citées dans les sources.", "CdC"}, {"cdc|da_donnees", "Données et qualité", "Décrit les sources de données, leur qualité et leur disponibilité. Module : données et IA.", "CdC"}, {"cdc|da_gouvernance", "Gouvernance, éthique et conformité", "Décrit les exigences de gouvernance, d'éthique et de conformité. Module : données et IA.", "CdC"}, {"cdc|da_modele", "Performance et évaluation du modèle", "Décrit les critères de performance du modèle tels que les décisions confirmées les fixent. Module : données et IA.", "CdC"}, {"cdc|etu_questions", "Questions à traiter", "Liste les questions auxquelles l'étude doit répondre. Module : étude et conseil.", "CdC"}, {"cdc|etu_restitution", "Restitution et validation", "Décrit la restitution et la validation de l'étude telles que les décisions confirmées les fixent. Module : étude et conseil.", "CdC"}, {"cdc|fonctionnelles", "Exigences fonctionnelles", "Énumère les exigences fonctionnelles sous forme d'énoncés courts « Le système doit… », numérotées REQ-1, REQ-2…, une exigence par phrase, sans ambiguïté…", "CdC"}, {"cdc|frm_evaluation", "Évaluation des acquis", "Décrit l'évaluation de la formation telle que les décisions confirmées la fixent. Module : formation.", "CdC"}, {"cdc|frm_programme", "Programme et modalités", "Décrit le programme et les modalités pédagogiques. Module : formation.", "CdC"}, {"cdc|frm_public", "Public et besoins de formation", "Décrit le public visé et ses besoins de formation. Module : formation.", "CdC"}, {"cdc|inf_garantie", "Réception et garanties", "Décrit les modalités de réception et les garanties telles que les décisions confirmées les fixent. Module : infrastructure et travaux.", "CdC"}, {"cdc|inf_normes", "Normes et conformité techniques", "Décrit les normes et exigences réglementaires applicables. Module : infrastructure et travaux.", "CdC"}, {"cdc|inf_site", "Site, accès et existant", "Décrit le site, ses accès et l'existant. Module : infrastructure et travaux.", "CdC"}, {"cdc|non_fonctionnelles", "Exigences non fonctionnelles", "Énumère performance, sécurité, disponibilité et autres exigences non fonctionnelles sourcées, numérotées NFR-1, NFR-2…, chacune mesurable (seuil ou critère…", "CdC"}, {"cdc|perimetre", "Périmètre", "Délimite le périmètre du projet : ce qui est inclus et exclu.", "CdC"}, {"cdc|recette", "Conditions de recette", "Décrit les critères d'acceptation et la méthode de vérification (inspection, analyse, démonstration, essai) indiqués dans les sources, en renvoyant aux…", "CdC"}, {"cdc|srv_niveaux", "Niveaux de service et pénalités", "Décrit les niveaux de service et pénalités tels que les décisions confirmées les fixent. Module : services et externalisation.", "CdC"}, {"cdc|srv_perimetre", "Périmètre du service", "Décrit les services attendus et leur périmètre. Module : services et externalisation.", "CdC"}, {"cdc|srv_reversibilite", "Transfert et réversibilité", "Décrit le transfert de service et la réversibilité. Module : services et externalisation.", "CdC"}, {"cdc|sup_garantie", "Garantie et service après-vente", "Décrit la garantie et le service après-vente tels que les décisions confirmées les fixent. Module : fournitures.", "CdC"}, {"cdc|sup_livraison", "Livraison, installation et réception", "Décrit la livraison et la réception telles que les décisions confirmées les fixent. Module : fournitures.", "CdC"}, {"cdc|sup_specs", "Spécifications des fournitures", "Décrit les caractéristiques et quantités des fournitures. Module : fournitures.", "CdC"}, {"cdc|sw_integration", "Architecture et intégration", "Décrit l'architecture cible et les intégrations avec l'existant. Module : logiciel et SI.", "CdC"}, {"cdc|sw_maintenance", "Maintenance et niveaux de service", "Décrit la maintenance et les niveaux de service tels que les décisions confirmées les fixent. Module : logiciel et SI.", "CdC"}, {"cdc|sw_securite", "Sécurité et données", "Décrit les exigences de sécurité et de protection des données. Module : logiciel et SI.", "CdC"}, {"findings|_findings", "Extraction des constats", "Lit les rapports d'audit et en extrait les constats, un par entrée.", "Constats"}, {"findings|constats", "Constats du diagnostic", "Extrait les constats observables des documents : problème, thème, gravité, avec la source de chacun.", "Constats"}, {"roadmap|_axes", "Regroupement en axes", "Nomme les axes de transformation qui regroupent les constats.", "Feuille de route"}, {"roadmap|_initiatives", "Initiatives par axe", "Propose les initiatives de chaque axe, rattachées à leurs constats.", "Feuille de route"}, {"roadmap|axes", "Axes stratégiques", "Présente les axes stratégiques qui regroupent les initiatives, chacun rattaché à des constats.", "Feuille de route"}, {"roadmap|calendrier", "Calendrier", "Propose un séquencement par vagues à partir des priorités et dépendances, sans inventer de dates absentes des sources.", "Feuille de route"}, {"roadmap|initiatives", "Initiatives", "Décrit chaque initiative retenue : objet, constats traités, ordre de réalisation et dépendances.", "Feuille de route"}, {"roadmap|risques", "Risques", "Énumère les risques de mise en œuvre mentionnés ou déduits des passages, avec leur source ; pour chacun : vraisemblance et conséquence si les passages les…", "Feuille de route"}, {"roadmap|synthese", "Synthèse", "Résume en quelques phrases la situation et l'ambition de la feuille de route à partir des constats validés.", "Feuille de route"}, {"tor|calendrier", "Calendrier de la mission", "Décrit la durée et les jalons de la mission tels qu'ils ressortent des décisions confirmées.", "TdR"}, {"tor|chg_competences", "Compétences en conduite du changement", "Décrit les compétences exigées telles que les décisions confirmées les fixent. Module : organisation et conduite du changement.", "TdR"}, {"tor|contexte", "Contexte et justification", "Résume le contexte institutionnel et les constats qui motivent la mission.", "TdR"}, {"tor|da_competences", "Compétences en données et IA", "Décrit les profils data et IA exigés tels que les décisions confirmées les fixent. Module : données et IA.", "TdR"}, {"tor|etu_methodologie", "Méthodologie attendue", "Décrit la démarche et les méthodes attendues. Module : étude et conseil.", "TdR"}, {"tor|evaluation", "Critères d'évaluation", "Présente les critères d'évaluation tels que les décisions confirmées les fixent.", "TdR"}, {"tor|frm_formateurs", "Profil des formateurs", "Décrit le profil des formateurs tel que les décisions confirmées le fixent. Module : formation.", "TdR"}, {"tor|inf_competences", "Compétences et habilitations", "Décrit les compétences et habilitations exigées telles que les décisions confirmées les fixent. Module : infrastructure et travaux.", "TdR"}, {"tor|livrables", "Livrables attendus", "Liste les livrables attendus avec leur contenu, uniquement ceux appuyés par les sources.", "TdR"}, {"tor|objectifs", "Objectifs de la mission", "Formule les objectifs général et spécifiques de la mission, en lien avec les constats.", "TdR"}, {"tor|profil", "Profil des experts", "Décrit les profils et qualifications requis des experts tels que les décisions confirmées les fixent.", "TdR"}, {"tor|srv_pilotage", "Pilotage du contrat", "Décrit la gouvernance et le pilotage du contrat. Module : services et externalisation.", "TdR"}, {"tor|sw_competences", "Compétences techniques requises", "Décrit les compétences techniques exigées telles que les décisions confirmées les fixent. Module : logiciel et SI.", "TdR"}}),
				    Vues = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_generation"), {"type_code", "section_code", "section_title"}), {{"type_code", type text}, {"section_code", type text}, {"section_title", type text}}, CultureCsv),
				    Cles = Table.Distinct(Table.AddColumn(Vues, "cle", each [type_code] & "|" & [section_code], type text), {"cle"}),
				    Absentes = Table.SelectRows(Cles, each not List.Contains(Gabarits[cle], [cle])),
				    AvecLibelle = Table.AddColumn(Absentes, "libelle", each [section_title], type text),
				    AvecRole = Table.AddColumn(AvecLibelle, "role", each "Section sans description dans les gabarits", type text),
				    AvecLivrable = Table.AddColumn(AvecRole, "livrable", each Record.FieldOrDefault([#"findings" = "Constats", #"roadmap" = "Feuille de route", #"tor" = "TdR", #"cdc" = "CdC"], [type_code], "Autre"), type text),
				    Resultat = Table.Combine({Gabarits, Table.SelectColumns(AvecLivrable, {"cle", "libelle", "role", "livrable"})})
				in
				    Resultat
