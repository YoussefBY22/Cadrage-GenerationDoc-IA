table 'Générations'
	isHidden

	column 'Clé de date'
		dataType: int64
		isHidden
		sourceColumn: date_key
		summarizeBy: none

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Clé de consultant'
		dataType: int64
		isHidden
		sourceColumn: author_key
		summarizeBy: none

	column 'Code du type'
		dataType: string
		isHidden
		sourceColumn: type_code
		summarizeBy: none

	column Statut
		dataType: string
		isHidden
		sourceColumn: status
		summarizeBy: none

	column 'Phrases produites'
		dataType: int64
		isHidden
		sourceColumn: sentences_total
		summarizeBy: none

	column 'Phrases validées'
		dataType: int64
		isHidden
		sourceColumn: sentences_verified
		summarizeBy: none

	column 'Citations produites'
		dataType: int64
		isHidden
		sourceColumn: citations_total
		summarizeBy: none

	column 'Citations valides en nombre'
		dataType: int64
		isHidden
		sourceColumn: citations_valid
		summarizeBy: none

	partition 'Générations' = m
		mode: import
		source =
				let
				    Brut = Vue("v_generation"),
				    Choix = Table.SelectColumns(Brut, {"date_key", "mission_key", "author_key", "type_code", "status", "sentences_total", "sentences_verified", "citations_total", "citations_valid"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"date_key", Int64.Type}, {"mission_key", Int64.Type}, {"author_key", Int64.Type}, {"type_code", type text}, {"status", type text}, {"sentences_total", Int64.Type}, {"sentences_verified", Int64.Type}, {"citations_total", Int64.Type}, {"citations_valid", Int64.Type}}, CultureCsv)
				in
				    Typage
