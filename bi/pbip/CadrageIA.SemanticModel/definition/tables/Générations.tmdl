table 'Générations'

	column 'Clé de date'
		dataType: int64
		isHidden
		sourceColumn: date_key
		summarizeBy: none

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Clé de consultant'
		dataType: int64
		isHidden
		sourceColumn: author_key
		summarizeBy: none

	column 'Code du type'
		dataType: string
		isHidden
		sourceColumn: type_code
		summarizeBy: none

	column 'Code de section'
		dataType: string
		isHidden
		sourceColumn: section_code
		summarizeBy: none

	column 'Nom du modèle'
		dataType: string
		isHidden
		sourceColumn: model_name
		summarizeBy: none

	column Statut
		dataType: string
		isHidden
		sourceColumn: status
		summarizeBy: none

	column 'Phrases produites'
		dataType: int64
		isHidden
		sourceColumn: sentences_total
		summarizeBy: none

	column 'Phrases validées'
		dataType: int64
		isHidden
		sourceColumn: sentences_verified
		summarizeBy: none

	column 'Phrases à revoir'
		dataType: int64
		isHidden
		sourceColumn: sentences_warning
		summarizeBy: none

	column 'Phrases non vérifiées'
		dataType: int64
		isHidden
		sourceColumn: sentences_failed
		summarizeBy: none

	column 'Citations produites'
		dataType: int64
		isHidden
		sourceColumn: citations_total
		summarizeBy: none

	column 'Citations valides'
		dataType: int64
		isHidden
		sourceColumn: citations_valid
		summarizeBy: none

	column 'Durée en ms'
		dataType: int64
		isHidden
		sourceColumn: latency_ms
		summarizeBy: none

	column 'Est une démonstration'
		dataType: int64
		isHidden
		sourceColumn: is_demo
		summarizeBy: none

	column 'Clé de section'
		dataType: string
		isHidden
		sourceColumn: cle_section
		summarizeBy: none

	column 'Résultat'
		dataType: string
		sourceColumn: resultat
		summarizeBy: none

	column 'Modèle'
		dataType: string
		sourceColumn: modele
		summarizeBy: none

	column 'En erreur'
		dataType: int64
		isHidden
		sourceColumn: en_erreur
		summarizeBy: none

	partition 'Générations' = m
		mode: import
		source =
				let
				    Brut = Vue("v_generation"),
				    Choix = Table.SelectColumns(Brut, {"date_key", "mission_key", "author_key", "type_code", "section_code", "model_name", "status", "sentences_total", "sentences_verified", "sentences_warning", "sentences_failed", "citations_total", "citations_valid", "latency_ms", "is_demo"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"date_key", Int64.Type}, {"mission_key", Int64.Type}, {"author_key", Int64.Type}, {"type_code", type text}, {"section_code", type text}, {"model_name", type text}, {"status", type text}, {"sentences_total", Int64.Type}, {"sentences_verified", Int64.Type}, {"sentences_warning", Int64.Type}, {"sentences_failed", Int64.Type}, {"citations_total", Int64.Type}, {"citations_valid", Int64.Type}, {"latency_ms", Int64.Type}, {"is_demo", Int64.Type}}, CultureCsv),
				    AvecSection = Table.AddColumn(Typage, "cle_section", each [type_code] & "|" & [section_code], type text),
				    AvecErreur = Table.AddColumn(AvecSection, "en_erreur", each if [status] = "invalid" or ([status] = "ok" and ([sentences_failed] > 0 or [citations_valid] < [citations_total])) then 1 else 0, Int64.Type),
				    AvecResultat = Table.AddColumn(AvecErreur, "resultat", each if [status] = "ok" and [en_erreur] = 1 then "Réussi, avec phrase ou citation fautive" else Record.FieldOrDefault([#"ok" = "Réussi", #"refused" = "Refus voulu (preuve insuffisante)", #"invalid" = "Sortie invalide"], [status], "Autre"), type text),
				    AvecModele = Table.AddColumn(AvecResultat, "modele", each if [is_demo] = 1 then "[DÉMO] modèle de démonstration" else if Text.Contains([model_name] ?? "", "lora") then "Qwen3-4B + LoRA v4 (adopté)" else if Text.Contains([model_name] ?? "", "base") then "Qwen3-4B de base" else [model_name] ?? "Inconnu", type text)
				in
				    AvecModele
