table 'Choix du client'

	column 'Client choisi'
		dataType: string
		sourceColumn: choix
		sortByColumn: Rang
		summarizeBy: none

	column Cible
		dataType: string
		isHidden
		sourceColumn: cible
		summarizeBy: none

	column Rang
		dataType: int64
		isHidden
		sourceColumn: rang
		summarizeBy: none

	partition 'Choix du client' = m
		mode: import
		source =
				let
				    Valeurs = List.Buffer(List.Sort(List.Distinct(List.RemoveNulls(Table.Column(Table.TransformColumnTypes(Table.SelectColumns(Vue("v_project"), {"client_name"}), {{"client_name", type text}}, CultureCsv), "client_name"))))),
				    Toutes = List.Transform(Valeurs, each {"Tous", _, 0}),
				    Chacune = List.Transform(List.Positions(Valeurs), each {Valeurs{_}, Valeurs{_}, _ + 1}),
				    Resultat = #table(type table [choix = text, cible = text, rang = Int64.Type], Toutes & Chacune)
				in
				    Resultat
