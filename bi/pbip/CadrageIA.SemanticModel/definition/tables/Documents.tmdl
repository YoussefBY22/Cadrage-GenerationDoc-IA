table Documents

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Code de format'
		dataType: string
		isHidden
		sourceColumn: mime
		summarizeBy: none

	column Format
		dataType: string
		sourceColumn: format
		summarizeBy: none

	column Alertes
		dataType: int64
		isHidden
		sourceColumn: injection_alert_count
		summarizeBy: none

	partition Documents = m
		mode: import
		source =
				let
				    Brut = Vue("v_security"),
				    Choix = Table.SelectColumns(Brut, {"mission_key", "mime", "injection_alert_count"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"mission_key", Int64.Type}, {"mime", type text}, {"injection_alert_count", Int64.Type}}, CultureCsv),
				    AvecFormat = Table.AddColumn(Typage, "format", each if [mime] = null then "Autre" else Record.FieldOrDefault([#"application/pdf" = "PDF", #"text/plain" = "Texte", #"text/markdown" = "Markdown", #"application/vnd.openxmlformats-officedocument.wordprocessingml.document" = "Word", #"application/vnd.openxmlformats-officedocument.presentationml.presentation" = "PowerPoint"], [mime], "Autre"), type text)
				in
				    AvecFormat
