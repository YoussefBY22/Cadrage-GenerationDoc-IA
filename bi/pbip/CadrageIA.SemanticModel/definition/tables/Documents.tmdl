table Documents

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Clé de document'
		dataType: int64
		isHidden
		sourceColumn: document_key
		summarizeBy: none

	column 'Code de format'
		dataType: string
		isHidden
		sourceColumn: mime
		summarizeBy: none

	column Format
		dataType: string
		sourceColumn: format
		summarizeBy: none

	column Alertes
		dataType: int64
		isHidden
		sourceColumn: injection_alert_count
		summarizeBy: none

	column 'Clé de date'
		dataType: int64
		isHidden
		sourceColumn: date_key
		summarizeBy: none

	partition Documents = m
		mode: import
		source =
				let
				    Brut = Vue("v_security"),
				    Choix = Table.SelectColumns(Brut, {"mission_key", "document_key", "mime", "injection_alert_count"}, MissingField.UseNull),
				    Typage = Table.TransformColumnTypes(Choix, {{"mission_key", Int64.Type}, {"document_key", Int64.Type}, {"mime", type text}, {"injection_alert_count", Int64.Type}}, CultureCsv),
				    AvecFormat = Table.AddColumn(Typage, "format", each Record.FieldOrDefault([#"application/pdf" = "PDF", #"text/plain" = "Texte", #"application/vnd.openxmlformats-officedocument.wordprocessingml.document" = "Word", #"application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" = "Excel", #"application/vnd.openxmlformats-officedocument.presentationml.presentation" = "PowerPoint"], [mime], "Autre"), type text),
				    Generations = Table.TransformColumnTypes(Table.SelectColumns(Vue("v_generation"), {"mission_key", "date_key"}), {{"mission_key", Int64.Type}, {"date_key", Int64.Type}}, CultureCsv),
				    DateParMission = Table.Group(Generations, {"mission_key"}, {{"date_key", each List.Min([date_key]), Int64.Type}}),
				    Jointure = Table.NestedJoin(AvecFormat, {"mission_key"}, DateParMission, {"mission_key"}, "mission", JoinKind.LeftOuter),
				    AvecDate = Table.ExpandTableColumn(Jointure, "mission", {"date_key"})
				in
				    AvecDate
