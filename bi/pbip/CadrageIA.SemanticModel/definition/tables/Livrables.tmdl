table Livrables

	column 'Identifiant du livrable'
		dataType: string
		isHidden
		sourceColumn: deliverable_id
		summarizeBy: none

	column 'Clé de mission'
		dataType: int64
		isHidden
		sourceColumn: mission_key
		summarizeBy: none

	column 'Clé de type'
		dataType: int64
		isHidden
		sourceColumn: type_key
		summarizeBy: none

	column 'Clé de consultant'
		dataType: int64
		isHidden
		sourceColumn: author_key
		summarizeBy: none

	column 'Clé de responsable'
		dataType: int64
		isHidden
		sourceColumn: reviewer_key
		summarizeBy: none

	column 'Clé de création'
		dataType: int64
		isHidden
		sourceColumn: created_date_key
		summarizeBy: none

	column 'Code d''état'
		dataType: string
		isHidden
		sourceColumn: state
		summarizeBy: none

	column 'Phrases bloquantes'
		dataType: int64
		isHidden
		sourceColumn: blocking_open
		summarizeBy: none

	column 'Citations sans source'
		dataType: int64
		isHidden
		sourceColumn: citations_invalid
		summarizeBy: none

	column 'État'
		dataType: string
		sourceColumn: etat
		sortByColumn: 'Ordre d''état'
		summarizeBy: none

	column 'Ordre d''état'
		dataType: int64
		isHidden
		sourceColumn: ordre
		summarizeBy: none

	partition Livrables = m
		mode: import
		source =
				let
				    Brut = Vue("v_deliverable"),
				    Choix = Table.SelectColumns(Brut, {"deliverable_id", "mission_key", "type_key", "author_key", "reviewer_key", "created_date_key", "state", "blocking_open", "citations_invalid"}),
				    Typage = Table.TransformColumnTypes(Choix, {{"deliverable_id", type text}, {"mission_key", Int64.Type}, {"type_key", Int64.Type}, {"author_key", Int64.Type}, {"reviewer_key", Int64.Type}, {"created_date_key", Int64.Type}, {"state", type text}, {"blocking_open", Int64.Type}, {"citations_invalid", Int64.Type}}, CultureCsv),
				    AvecEtat = Table.AddColumn(Typage, "etat", each if [state] = null then "Inconnu" else Record.FieldOrDefault([#"draft" = "Brouillon", #"in_review" = "En relecture", #"approved" = "Approuvé", #"rejected" = "Renvoyé"], [state], "Inconnu"), type text),
				    AvecOrdre = Table.AddColumn(AvecEtat, "ordre", each Number.From(Record.FieldOrDefault([#"draft" = "1", #"in_review" = "2", #"approved" = "3", #"rejected" = "4"], [state], "9")), Int64.Type)
				in
				    AvecOrdre
